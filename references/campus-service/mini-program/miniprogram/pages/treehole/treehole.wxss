/* pages/treehole/treehole.wxss — 树洞（信纸风） */

.page-treehole {
  position: relative;
  width: 100%;
  height: 100vh;
  background:
    radial-gradient(circle at 10% 8%, rgba(124, 197, 118, 0.04) 0%, transparent 30%),
    radial-gradient(circle at 90% 70%, rgba(255, 149, 0, 0.05) 0%, transparent 35%),
    #FFFBF0;
  color: #2A1A05;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  overflow: hidden;
  -webkit-overflow-scrolling: auto;
}

/* ===== 顶部栏（贴顶） ===== */
.th-top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 251, 240, 0.85);
  backdrop-filter: blur(28rpx) saturate(180%);
  -webkit-backdrop-filter: blur(28rpx) saturate(180%);
}
.th-topbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 12rpx;
}
.th-topbar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 树洞 logo：树冠 + 树干 + 树洞眼睛 */
.th-logo {
  width: 56rpx; height: 56rpx;
  position: relative;
  flex-shrink: 0;
}
.th-logo-leaves {
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 50rpx; height: 38rpx;
  background: radial-gradient(circle at 30% 40%, #8FC580 0%, #5B8C5A 75%);
  border-radius: 50% 50% 45% 45% / 60% 60% 40% 40%;
  box-shadow:
    -8rpx 4rpx 0 -4rpx #5B8C5A,
    8rpx 6rpx 0 -4rpx #5B8C5A;
}
.th-logo-leaves::after {
  content: '';
  position: absolute;
  top: 8rpx; left: 50%;
  transform: translateX(-50%);
  width: 6rpx; height: 6rpx;
  background: #6B4420;
  border-radius: 50%;
  box-shadow: -10rpx 0 0 -1rpx #6B4420, 10rpx 0 0 -1rpx #6B4420;
}
.th-logo-trunk {
  position: absolute;
  bottom: 6rpx; left: 50%;
  transform: translateX(-50%);
  width: 14rpx; height: 22rpx;
  background: linear-gradient(180deg, #A06A38 0%, #6B4420 100%);
  border-radius: 2rpx 2rpx 4rpx 4rpx;
}

.th-title-wrap {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}
.th-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #2A1A05;
  letter-spacing: 1rpx;
}
.th-subtitle {
  font-size: 18rpx;
  color: #B49A6A;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
  font-weight: 500;
}

/* 右上角圆形发帖按钮（已废弃，由 FAB 替代） */
.th-post-btn {
  display: none;
}

/* ===== 悬浮 FAB 按钮（可拖动） ===== */
.th-fab-wrap {
  position: fixed;
  width: 96rpx;
  height: 96rpx;
  z-index: 999;
}
.th-fab {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}
.th-fab.dragging {
  transform: scale(1.05);
}

/* FAB 阴影层（呼吸光晕） */
.th-fab-shadow {
  position: absolute;
  inset: -10rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 149, 0, 0.22) 0%, transparent 70%);
  animation: fab-pulse 2.4s ease-in-out infinite;
  pointer-events: none;
}
.th-fab.dragging .th-fab-shadow {
  animation: none;
  opacity: 0.6;
}
@keyframes fab-pulse {
  0%, 100% { transform: scale(1); opacity: 0.7; }
  50% { transform: scale(1.15); opacity: 1; }
}

/* FAB 本体：渐变球 */
.th-fab-inner {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB340 0%, #FF9500 50%, #E68600 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 8rpx 20rpx rgba(255, 149, 0, 0.40),
    0 2rpx 6rpx rgba(180, 80, 0, 0.20),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.4),
    inset 0 -3rpx 6rpx rgba(180, 80, 0, 0.2);
  transition: transform 0.15s;
}
.th-fab-hover .th-fab-inner,
.th-fab:active .th-fab-inner {
  transform: scale(0.92);
}
.th-fab-icon {
  color: #fff;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -2rpx;
  text-shadow: 0 2rpx 4rpx rgba(180, 80, 0, 0.3);
}
.th-fab-text {
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-top: 2rpx;
  text-shadow: 0 1rpx 2rpx rgba(180, 80, 0, 0.3);
}

/* ===== 排序 tabs ===== */
.th-tabs {
  padding: 8rpx 32rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.th-tab-group {
  display: flex;
  gap: 6rpx;
  background: rgba(180, 130, 40, 0.08);
  border-radius: 28rpx;
  padding: 6rpx;
}
.th-tab {
  font-size: 28rpx;
  color: #8A6A40;
  padding: 10rpx 28rpx;
  border-radius: 26rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  transition: all 0.25s;
}
.th-tab.active {
  background: #fff;
  color: #FF9500;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(180, 130, 40, 0.12);
}
.th-stat {
  font-size: 20rpx;
  color: #B49A6A;
  letter-spacing: 1rpx;
}

/* ===== 分类筛选条（彩色 chip） ===== */
.th-filter-bar {
  white-space: nowrap;
  margin-top: -10rpx;
  padding: 0 28rpx 12rpx;
  box-sizing: border-box;
  background: transparent;
}
.th-filter-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  margin-right: 12rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  background: transparent;
  border: 1.5rpx solid transparent;
  transition: all 0.2s;
  flex-shrink: 0;
  color: #8A6A40;
  border-color: rgba(180, 130, 40, 0.15);
}
.th-filter-chip--all { color: #FF9500; }
.th-filter-chip--find { color: #E91E63; }
.th-filter-chip--complain { color: #9C27B0; }
.th-filter-chip--help { color: #2196F3; }
.th-filter-chip--share { color: #5B8C5A; }

.th-filter-chip.active.th-filter-chip--all {
  background: linear-gradient(135deg, #FFB340 0%, #FF9500 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(255, 149, 0, 0.30);
}
.th-filter-chip.active.th-filter-chip--find {
  background: linear-gradient(135deg, #FF6B9D 0%, #E91E63 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(233, 30, 99, 0.30);
}
.th-filter-chip.active.th-filter-chip--complain {
  background: linear-gradient(135deg, #BA68C8 0%, #9C27B0 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(156, 39, 176, 0.30);
}
.th-filter-chip.active.th-filter-chip--help {
  background: linear-gradient(135deg, #64B5F6 0%, #2196F3 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.30);
}
.th-filter-chip.active.th-filter-chip--share {
  background: linear-gradient(135deg, #81C784 0%, #5B8C5A 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(91, 140, 90, 0.30);
}

/* ===== 滚动区 ===== */
.th-scroll {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: 0 28rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 顶部诗体 ===== */
.th-poem {
  margin: 16rpx 20rpx 36rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: linear-gradient(135deg, rgba(255, 247, 224, 0.95) 0%, rgba(255, 232, 188, 0.9) 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 149, 0, 0.18);
  box-shadow: 0 4rpx 16rpx rgba(255, 149, 0, 0.08);
}
.th-poem-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.th-poem-line {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A2E08;
  letter-spacing: 2rpx;
  line-height: 1.55;
}
.th-poem-key {
  color: #FF7A00;
  font-weight: 900;
  position: relative;
  font-style: normal;
}
.th-poem-key::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: -2rpx;
  height: 10rpx;
  background: linear-gradient(180deg, transparent 45%, rgba(255, 167, 38, 0.45) 45%);
  z-index: -1;
  border-radius: 2rpx;
}
.th-poem-desc {
  font-size: 23rpx;
  color: #8A6A40;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
  font-weight: 500;
}
.th-poem-emoji {
  font-size: 88rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 4rpx 10rpx rgba(124, 197, 118, 0.25));
  margin-left: 8rpx;
}

/* ===== 时间分割线 ===== */
.th-date-divider {
  display: flex;
  align-items: center;
  margin: 28rpx 8rpx 16rpx;
}
.th-date-divider::before, .th-date-divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: rgba(180, 130, 40, 0.10);
}
.th-date-divider text {
  font-size: 22rpx;
  color: #B49A6A;
  letter-spacing: 4rpx;
  padding: 0 24rpx;
}

/* ===== 信纸风帖子 ===== */
.th-note {
  position: relative;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 32rpx 24rpx;
  margin-bottom: 32rpx;
  box-shadow:
    0 2rpx 8rpx rgba(180, 130, 40, 0.06),
    0 12rpx 28rpx rgba(180, 130, 40, 0.05);
  transition: all 0.2s;
}
.th-note:active {
  transform: scale(0.99);
}
/* 信纸横线纹理（极淡） */
.th-note::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: linear-gradient(
    180deg,
    transparent 0,
    transparent 119rpx,
    rgba(180, 130, 40, 0.05) 119rpx,
    rgba(180, 130, 40, 0.05) 120rpx
  );
  background-size: 100% 120rpx;
  border-radius: 20rpx;
  pointer-events: none;
}
/* 信纸折角 */
.th-note-fold {
  position: absolute;
  top: 0; left: 0;
  width: 0; height: 0;
  border-style: solid;
  border-width: 24rpx 24rpx 0 0;
  border-color: #FFF4DA transparent transparent transparent;
  border-top-left-radius: 20rpx;
  filter: drop-shadow(2rpx 2rpx 2rpx rgba(180, 130, 40, 0.08));
}

.th-note-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}
.th-note-avatar {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF1D6 0%, #FFE0B0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgba(180, 130, 40, 0.10);
  position: relative;
}
.th-avatar-emoji {
  font-size: 40rpx;
  line-height: 1;
}
.th-avatar-badge {
  position: absolute;
  bottom: -4rpx; right: -4rpx;
  width: 30rpx; height: 30rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
  border: 2rpx solid #fff;
}
.th-note-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.th-note-id {
  font-size: 26rpx;
  color: #2A1A05;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.th-note-id-tag {
  font-size: 20rpx;
  color: #B49A6A;
  font-weight: 500;
}
.th-official-v {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(74, 144, 217, 0.18);
  color: #3568B2;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0;
  flex-shrink: 0;
  margin-left: 2rpx;
  border: 1rpx solid rgba(53, 104, 178, 0.25);
}
.th-note-time {
  font-size: 20rpx;
  color: #B49A6A;
  letter-spacing: 1rpx;
}
.th-note-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}
.th-tag-find { background: rgba(233, 30, 99, 0.08); color: #E91E63; }
.th-tag-complain { background: rgba(156, 39, 176, 0.08); color: #9C27B0; }
.th-tag-help { background: rgba(33, 150, 243, 0.08); color: #2196F3; }
.th-tag-share { background: rgba(91, 140, 90, 0.10); color: #5B8C5A; }

.th-note-body {
  position: relative;
  z-index: 1;
}
.th-note-content {
  font-size: 30rpx;
  color: #2A1A05;
  line-height: 1.75;
  letter-spacing: 0.5rpx;
  word-break: break-all;
  display: block;
}
.th-note-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 20rpx;
}
.th-note-images.single {
  grid-template-columns: 1fr;
}
.th-note-img {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 50rpx;
  background: #FFF4DA;
}
.th-note-images.single .th-note-img {
  aspect-ratio: 1.4;
}
/* emoji 卡片 */
.th-note-emoji {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  box-shadow: 0 2rpx 6rpx rgba(180,130,40,0.10);
}
.th-note-images.single .th-note-emoji {
  aspect-ratio: 1.4;
  font-size: 96rpx;
}

.th-note-foot {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(180, 130, 40, 0.10);
  position: relative;
  z-index: 1;
}
.th-note-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #8A6A40;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}
.th-note-action-right {
  margin-left: auto;
}
.th-note-action.liked { color: #FF4757; font-weight: 700; }

.th-icon-heart {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  font-size: 28rpx;
  line-height: 1;
  color: #B49A6A;
  flex-shrink: 0;
}
.th-note-action.liked .th-icon-heart {
  color: #FF4757;
  filter: drop-shadow(0 1rpx 2rpx rgba(255, 71, 87, 0.3));
}

/* 评论气泡 */
.th-icon-cmt {
  position: relative;
  width: 28rpx; height: 22rpx;
  flex-shrink: 0;
  transform: translateY(2rpx);
}
.th-icon-cmt {
  border: 2rpx solid currentColor;
  border-radius: 6rpx;
  width: 28rpx; height: 20rpx;
  box-sizing: border-box;
}
.th-icon-cmt::after {
  content: '';
  position: absolute;
  bottom: -5rpx; left: 5rpx;
  width: 0; height: 0;
  border-left: 4rpx solid transparent;
  border-right: 4rpx solid transparent;
  border-top: 5rpx solid currentColor;
}

/* 分享：三角连线 */
.th-icon-share {
  position: relative;
  width: 28rpx; height: 28rpx;
  flex-shrink: 0;
  transform: translateY(2rpx);
}

.th-icon-share-d1, .th-icon-share-d2, .th-icon-share-d3 {
  position: absolute;
  width: 8rpx; height: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  background: #FFFBF0;
}
.th-icon-share-d1 { top: 0; left: 0; }
.th-icon-share-d2 { top: 0; right: 0; }
.th-icon-share-d3 { bottom: 0; left: 50%; transform: translateX(-50%); }
.th-icon-share::before {
  content: '';
  position: absolute;
  top: 6rpx; left: 4rpx;
  width: 18rpx; height: 1rpx;
  background: currentColor;
  transform: rotate(30deg);
  transform-origin: 0 50%;
}
.th-icon-share::after {
  content: '';
  position: absolute;
  top: 6rpx; right: 4rpx;
  width: 18rpx; height: 1rpx;
  background: currentColor;
  transform: rotate(-30deg);
  transform-origin: 100% 50%;
}

/* 删除图标 */
.th-icon-delete {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.th-icon-delete-line {
  position: absolute;
  top: 50%; left: 50%;
  width: 22rpx; height: 2.5rpx;
  background: currentColor;
  border-radius: 2rpx;
  transform-origin: center;
}
.th-icon-delete-l1 { transform: translate(-50%, -50%) rotate(45deg); }
.th-icon-delete-l2 { transform: translate(-50%, -50%) rotate(-45deg); }
.th-note-action-delete { color: #FF4757 !important; }

/* ===== 空状态 ===== */
.th-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 20rpx 40rpx;
  margin: 0 20rpx;
  box-sizing: border-box;
}
.th-empty-icon {
  position: relative;
  width: 140rpx; height: 140rpx;
  margin-bottom: 24rpx;
}
.th-empty-leaves {
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 120rpx; height: 90rpx;
  background: radial-gradient(circle at 30% 40%, #8FC580 0%, #5B8C5A 75%);
  border-radius: 50% 50% 45% 45% / 60% 60% 40% 40%;
  box-shadow:
    -16rpx 8rpx 0 -8rpx #5B8C5A,
    16rpx 12rpx 0 -8rpx #5B8C5A;
}
.th-empty-leaves::after {
  content: '';
  position: absolute;
  top: 18rpx; left: 50%;
  transform: translateX(-50%);
  width: 14rpx; height: 14rpx;
  background: #6B4420;
  border-radius: 50%;
  box-shadow: -20rpx 0 0 -2rpx #6B4420, 20rpx 0 0 -2rpx #6B4420;
}
.th-empty-trunk {
  position: absolute;
  bottom: 10rpx; left: 50%;
  transform: translateX(-50%);
  width: 32rpx; height: 50rpx;
  background: linear-gradient(180deg, #A06A38 0%, #6B4420 100%);
  border-radius: 4rpx 4rpx 8rpx 8rpx;
}
.th-empty-hole {
  position: absolute;
  bottom: 24rpx; left: 50%;
  transform: translateX(-50%);
  width: 22rpx; height: 18rpx;
  background: #2A1A05;
  border-radius: 50% 50% 8rpx 8rpx / 60% 60% 8rpx 8rpx;
}
.th-empty-title {
  font-size: 38rpx;
  color: #3A2A10;
  font-weight: 800;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}
.th-empty-hint {
  font-size: 26rpx;
  color: #A0825A;
  margin-bottom: 40rpx;
  letter-spacing: 1.5rpx;
  font-weight: 500;
}

.th-suggestions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  background: linear-gradient(135deg, rgba(255, 247, 224, 0.92) 0%, rgba(255, 240, 200, 0.85) 100%);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 20rpx;
  padding: 24rpx 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(180, 130, 40, 0.10);
  border: 1rpx solid rgba(255, 149, 0, 0.15);
  box-sizing: border-box;
}
.th-sug-title {
  font-size: 24rpx;
  color: #6A4820;
  font-weight: 600;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.th-sug-item {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  transition: all 0.2s;
  border: 1rpx solid rgba(255, 149, 0, 0.10);
}
.th-sug-item:active {
  background: rgba(255, 149, 0, 0.12);
  transform: scale(0.98);
  border-color: rgba(255, 149, 0, 0.30);
}
.th-sug-num {
  font-size: 24rpx;
  font-weight: 800;
  color: #FF9500;
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 149, 0, 0.12);
  border-radius: 50%;
  letter-spacing: 0.5rpx;
  font-family: "DIN Alternate", -apple-system, sans-serif;
}
.th-sug-text {
  font-size: 25rpx;
  color: #4A2E08;
  line-height: 1.4;
  flex: 1;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ===== 加载 / 结束 ===== */
.th-load-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #A0825A;
  letter-spacing: 2rpx;
}
.th-end-tip {
  text-align: center;
  padding: 32rpx 0;
  font-size: 22rpx;
  color: #B49A6A;
  letter-spacing: 2rpx;
}
.th-end-tip text::before, .th-end-tip text::after {
  content: '·';
  margin: 0 12rpx;
  color: #B49A6A;
}

/* ===== 弹窗通用 ===== */
.th-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fade-in 0.25s ease;
  padding: 0 40rpx;
}
@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.th-modal {
  width: 100%;
  box-sizing: border-box;
  max-height: 72vh;
  background: #FFFBF0;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  animation: pop-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 16rpx 48rpx rgba(60, 30, 0, 0.25);
  overflow: hidden;
}
@keyframes pop-in {
  from { transform: scale(0.85); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.th-modal-handle {
  display: none;
}
.th-modal-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 24rpx 12rpx;
  position: relative;
}
.th-modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2A1A05;
  letter-spacing: 2rpx;
}
.th-modal-sub {
  font-size: 22rpx;
  color: #A0825A;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}
.th-modal-close {
  position: absolute;
  right: 24rpx; top: 24rpx;
  width: 56rpx; height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(180, 130, 40, 0.08);
  border-radius: 50%;
  font-size: 28rpx;
  color: #8A6A40;
}
.th-modal-body {
  padding: 12rpx 32rpx 0;
  flex: 1;
  overflow-y: auto;
  box-sizing: border-box;
}
.th-textarea {
  width: 100%;
  min-height: 220rpx;
  font-size: 30rpx;
  color: #2A1A05;
  line-height: 1.7;
  padding: 0;
  letter-spacing: 0.5rpx;
  background: transparent;
}
.th-textarea-placeholder { color: #B49A6A; }
.th-char-count {
  text-align: right;
  font-size: 22rpx;
  color: #A0825A;
  margin-bottom: 0;
  letter-spacing: 1rpx;
}

/* 来自哪儿 单行输入 */
.th-meta-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.th-meta-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(255, 149, 0, 0.12);
  border-radius: 14rpx;
  padding: 10rpx 16rpx;
  min-width: 0;
}
.th-meta-item--full { flex: none; width: 500rpx; box-sizing: border-box; }
.th-meta-icon {
  font-size: 22rpx;
  flex-shrink: 0;
}
.th-meta-input {
  width: 100%;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #2A1A05;
  letter-spacing: 0.5rpx;
  min-width: 0;
  font-weight: 500;
}
.th-meta-placeholder {
  color: #B49A6A;
  font-size: 22rpx;
}

.th-upload-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.th-upload-label {
  font-size: 24rpx;
  color: #8A6A40;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.th-upload-counter {
  font-size: 22rpx;
  color: #FF9500;
  font-weight: 700;
  letter-spacing: 1rpx;
  font-family: "DIN Alternate", -apple-system, sans-serif;
}
.th-upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.th-upload-item {
  position: relative;
  width: 120rpx; height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.08);
}
.th-upload-img { width: 100%; height: 100%; }
.th-upload-del {
  position: absolute;
  top: 4rpx; right: 4rpx;
  width: 32rpx; height: 32rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #fff;
}
.th-upload-add {
  width: 120rpx; height: 120rpx;
  border-radius: 12rpx;
  border: 2rpx dashed rgba(255, 149, 0, 0.4);
  background: rgba(255, 149, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.th-upload-add-icon { font-size: 36rpx; color: #FF9500; font-weight: 300; }
.th-upload-add-text { font-size: 20rpx; color: #B47A30; margin-top: 2rpx; letter-spacing: 1rpx; }

.th-category-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}
.th-cat-label {
  font-size: 28rpx;
  color: #FF9500;
  flex-shrink: 0;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.th-cat-list {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  flex: 1;
}
.th-cat-item {
  padding: 10rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  color: #8A6A40;
  border: 2rpx solid transparent;
  font-weight: 500;
  transition: all 0.2s;
}
.th-cat-item.active {
  background: linear-gradient(135deg, #FF9500 0%, #FFB340 100%);
  color: #fff;
  font-weight: 700;
  box-shadow: 0 3rpx 10rpx rgba(255, 149, 0, 0.3);
}

.th-modal-footer {
  display: flex;
  padding: 20rpx 32rpx 36rpx;
  gap: 20rpx;
}

/* ===== 胶囊框 ===== */
.th-capsule-box {
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(255, 149, 0, 0.2);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.5);
  padding: 20rpx;
  margin-bottom: 24rpx;
}

/* ===== 匿名昵称行 ===== */
.th-nick-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.th-nick-label {
  font-size: 28rpx;
  color: #FF9500;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.th-nick-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.th-nick-input {
  flex: 1;
  margin-right: 0;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 149, 0, 0.12);
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #2A1A05;
  letter-spacing: 0.5rpx;
  box-sizing: border-box;
}
.th-nick-placeholder {
  color: #B49A6A;
  font-size: 24rpx;
}
.th-nick-random {
  flex-shrink: 0;
  padding: 0 22rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, rgba(255, 149, 0, 0.12) 0%, rgba(255, 179, 64, 0.12) 100%);
  border: 1rpx solid rgba(255, 149, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FF9500;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.th-modal-btn {
  flex: 1;
  height: 78rpx;
  border-radius: 39rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.th-modal-btn.cancel {
  background: rgba(180, 130, 40, 0.10);
  color: #8A6A40;
}
.th-modal-btn.confirm {
  background: linear-gradient(135deg, #FF9500 0%, #FFB340 100%);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(255, 149, 0, 0.35);
}
.th-modal-btn.confirm.disabled { opacity: 0.5; }

/* ===== 评论弹窗 ===== */
.th-comment-popup {
  width: 100%;
  max-height: 70vh;
  background: #FFFBF0;
  border-radius: 28rpx;
  padding: 24rpx 24rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(60, 30, 0, 0.25);
  animation: pop-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.th-cmt-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  position: relative;
}
.th-cmt-title { font-size: 32rpx; font-weight: 700; color: #2A1A05; letter-spacing: 1rpx; }
.th-cmt-close {
  position: absolute;
  right: 0; top: 50%;
  transform: translateY(-50%);
  width: 56rpx; height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(180, 130, 40, 0.08);
  border-radius: 50%;
  font-size: 28rpx;
  color: #8A6A40;
}
.th-cmt-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 评论列表 — scroll-view 需要固定高度，flex:1+height:0 强制约束 */
.th-cmt-list {
  flex: 1;
  height: 0;
  min-height: 120rpx;
  padding: 0 8rpx 16rpx;
}
.th-cmt-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 8rpx;
  border-bottom: 1rpx solid rgba(180, 130, 40, 0.08);
}
.th-cmt-item:last-child { border-bottom: none; }
.th-cmt-avatar {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF1D6, #FFE0B0);
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}
.th-cmt-content { flex: 1; min-width: 0; }
.th-cmt-name {
  font-size: 22rpx;
  color: #8A6A40;
  font-weight: 600;
  margin-bottom: 4rpx;
  letter-spacing: 0.5rpx;
}
.th-cmt-me {
  font-size: 22rpx;
  color: #D2691E;
  font-weight: 700;
  background: rgba(210,140,70,0.12);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}
.th-cmt-text {
  font-size: 26rpx;
  color: #2A1A05;
  line-height: 1.55;
  word-break: break-all;
}
.th-cmt-del {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
  border-radius: 50%;
  opacity: 0.45;
  transition: opacity 0.2s;
}
.th-cmt-del:active { opacity: 0.8; background: rgba(255, 59, 48, 0.08); }
.th-cmt-del-icon {
  font-size: 24rpx;
  color: #FF3B30;
  font-weight: 600;
}
.th-cmt-empty {
  text-align: center;
  font-size: 22rpx;
  color: #B49A6A;
  padding: 60rpx 20rpx;
  letter-spacing: 1rpx;
}
.th-cmt-input {
  flex: 1;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 40rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #2A1A05;
  border: 1rpx solid rgba(180, 130, 40, 0.10);
}
.th-cmt-placeholder { color: #B49A6A; }
.th-cmt-send {
  padding: 0 32rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #FF9500 0%, #FFB340 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 149, 0, 0.30);
  transition: opacity 0.2s;
}
.th-cmt-send--disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* ===== 离屏 canvas ===== */
.th-offscreen-canvas {
  position: fixed;
  top: -9999rpx;
  left: -9999rpx;
  width: 200rpx;
  height: 200rpx;
}

/* ===== 通用 ===== */
.th-bottom-safe { height: 40rpx; }
.tap-shrink:active { transform: scale(0.96); transition: transform 0.1s; }
