@import './pages/_shared/base.wxss';

/* 全局 Design Tokens - 暖色浅底模式（默认） */
page {
  background-color: #F5F5F7;
  --primary: #FF9500;
  --primary-light: #FFB347;
  --primary-dark: #E08600;
  --primary-gradient: linear-gradient(135deg, #FF9500 0%, #E08600 100%);
  --danger: #FF453A;
  --warning: #FF9F0A;
  --info: #0A84FF;
  --success: #30D158;
  --bg-page: #F5F5F7;
  --bg-white: #FFFFFF;
  --bg-card: #FFFFFF;
  --bg-card-hover: #F5F5F7;
  --text-primary: #1C1C1E;
  --text-secondary: rgba(28,28,30,.65);
  --text-hint: rgba(28,28,30,.40);
  --text-placeholder: rgba(28,28,30,.30);
  --border: rgba(0,0,0,.08);
  --border-light: rgba(0,0,0,.04);
  --shadow-sm: 0 2rpx 12rpx rgba(0,0,0,.06);
  --shadow-md: 0 8rpx 32rpx rgba(0,0,0,.08);
  --shadow-lg: 0 16rpx 48rpx rgba(0,0,0,.12);
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 44rpx;
  --radius-xl: 32rpx;
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 40rpx;

  /* 语义化变量（暖色浅底） */
  --nav-bg: rgba(255,255,255,0.92);
  --overlay-bg: rgba(0,0,0,.3);
  --card-inner-bg: rgba(0,0,0,.03);
  --badge-bg: rgba(0,0,0,.05);
  --card-inner-bg-2: rgba(0,0,0,.04);
  --card-inner-bg-3: rgba(0,0,0,.06);
  --card-inner-bg-hover: rgba(0,0,0,.04);
  --mine-gradient: linear-gradient(135deg, #FFB347 0%, #FF9500 55%, #E08600 100%);
  --mine-header-shadow: 0 8rpx 32rpx rgba(255,149,0,.15);
  --avatar-border: rgba(255,255,255,.8);
  --avatar-border-sm: rgba(255,255,255,.6);
  --avatar-border-lg: rgba(255,255,255,.9);
  --avatar-bg: rgba(255,255,255,.3);
  --stat-divider: rgba(255,255,255,.7);
  --menu-arrow: rgba(0,0,0,.3);
  --back-btn-bg: rgba(0,0,0,.05);
  --back-btn-border: rgba(0,0,0,.1);
  --duck-color: #1C1C1E;
  --input-bg: rgba(0,0,0,.04);
  --input-bg-2: rgba(0,0,0,.02);
  --dash-line: rgba(0,0,0,.15);
  --timeline-dot: rgba(0,0,0,.3);
  --btn-shadow-primary: 0 6rpx 24rpx rgba(255,149,0,.20);
  --danger-bg: rgba(255,69,58,.08);
  --danger-border: rgba(255,69,58,.25);
  --danger-bg-light: rgba(255,69,58,.06);
  --primary-bg: rgba(255,149,0,.08);
  --primary-bg-light: rgba(255,149,0,.05);
  --primary-bg-mid: rgba(255,149,0,.10);
  --primary-bg-strong: rgba(255,149,0,.12);
  --primary-border: rgba(255,149,0,.20);
  --primary-border-mid: rgba(255,149,0,.25);
  --warning-bg: rgba(255,159,10,.06);
  --warning-bg-mid: rgba(255,159,10,.08);
  --warning-border: rgba(255,159,10,.12);
  --info-bg: rgba(10,132,255,.10);
  --success-bg: rgba(48,209,88,.10);
  --pink: #FF6B8A;
  --pink-bg: rgba(255,107,138,.08);
  --blue: #5E8BFF;
  --blue-bg: rgba(94,139,255,.08);
  --text-on-primary: #FFFFFF;
  --modal-overlay: rgba(0,0,0,.4);
  --nav-bg-2: rgba(255,255,255,0.96);
  --topbar-gradient: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.95) 100%);
  --highlight-green: #FF5A5F;

  /* 首页专属语义变量 */
  --hero-gradient: linear-gradient(135deg, #FFD78E 0%, #FF9500 100%);
  --hot-rec-gradient: linear-gradient(135deg, #FF9500 0%, #FF6B35 100%);
  --search-btn-bg: #FF9500;
  --topbar-bg: #FFFFFF;

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: var(--font-md);
  color: var(--text-primary);
  background-color: var(--bg-page);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* 通用全屏背景图（各页面在 wxml 中放 <image class="page-bg">） */
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

/* 暗色模式 */
/* 通用按钮 - 主色调 */
.grad-btn {
  background: var(--primary);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: var(--font-lg);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  box-shadow: var(--btn-shadow-primary);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.grad-btn:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.grad-btn[disabled] {
  opacity: 0.4;
  transform: none;
}

/* 次要按钮 */
.btn-secondary {
  background: transparent;
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
  border-radius: 999rpx;
  font-size: var(--font-md);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  transition: all 0.2s;
}

.btn-secondary:active {
  background: var(--card-inner-bg-hover);
}

/* 点击缩放 */
.tap-shrink {
  transition: transform 0.1s ease;
}
.tap-shrink:active {
  transform: scale(0.95);
}

/* 通用卡片 */
.card {
  background: var(--bg-card);
  border-radius: 44rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  border: 1rpx solid var(--border-light);
}

/* 玻璃卡片（统一各页面内容容器） */
.glass-card {
  background: var(--bg-card);
  border-radius: 44rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-light);
}

/* 统一导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  background: var(--nav-bg);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid var(--border-light);
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back-icon {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid var(--text-primary);
  border-bottom: 4rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.nav-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  text-align: center;
  white-space: nowrap;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nav-placeholder {
  width: 72rpx;
  flex-shrink: 0;
}

/* 统一空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--card-inner-bg-2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: 2rpx solid var(--border);
}

.empty-icon text {
  font-size: 40rpx;
}

.empty-text {
  font-size: var(--font-lg);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--text-hint);
}

/* 统一加载 */
.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
  font-size: var(--font-sm);
  color: var(--text-hint);
}

.no-more {
  color: var(--text-placeholder);
  font-size: var(--font-xs);
}

/* 线条图标基础类 */
.icon-line {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
}

.icon-line svg {
  width: 100%;
  height: 100%;
}

/* 安全区适配 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 单行省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border-light);
}

/* 全局 spinner */
.spinner {
  width: 32rpx; height: 32rpx;
  border: 3rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* loading-more 带图标 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 48rpx 0;
  font-size: var(--font-sm);
  color: var(--text-hint);
}

/* ===== 全局鸭子矢量图标 ===== */
.top-duck-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  transform: scaleX(-1);
}
.td-head {
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  width: 16rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 3rpx solid var(--duck-color);
}
.td-eye {
  position: absolute;
  top: 8rpx;
  right: 18rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: var(--duck-color);
}
.td-beak {
  position: absolute;
  top: 12rpx;
  left: 4rpx;
  width: 14rpx;
  height: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: var(--warning);
}
.td-body {
  position: absolute;
  bottom: 2rpx;
  left: 10rpx;
  width: 26rpx;
  height: 20rpx;
  border-radius: 50% 50% 40% 40%;
  border: 3rpx solid var(--duck-color);
  background: var(--primary-bg-strong);
}
.td-wing {
  position: absolute;
  bottom: 10rpx;
  left: 22rpx;
  width: 14rpx;
  height: 10rpx;
  border-radius: 50%;
  border: 3rpx solid var(--duck-color);
  transform: rotate(-20deg);
}
.td-tail {
  position: absolute;
  bottom: 14rpx;
  right: 2rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid var(--duck-color);
  border-bottom: 3rpx solid var(--duck-color);
  transform: rotate(45deg);
}

/* ========== SVG Emoji Icons (全局) ========== */
.svg-ico {
  display: inline-block;
  width: 36rpx;
  height: 36rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  vertical-align: middle;
}

