/* pages/detail/detail.wxss */
page { background: transparent !important; }
.page-detail { min-height: 100vh; background: transparent; position: relative; }

.nav-bar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; align-items: center;
  background: #FFF3DC;
  border-bottom: 1rpx solid var(--border-light);
}

.nav-back {
  width: 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

.nav-back-icon {
  width: 24rpx; height: 24rpx;
  border-left: 4rpx solid var(--text-primary);
  border-bottom: 4rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.nav-title {
  font-size: var(--font-lg); font-weight: 600;
  flex: 1; text-align: center; color: var(--text-primary);
}

.nav-placeholder { width: 72rpx; flex-shrink: 0; }

.content { min-height: 100vh; padding: 24rpx 32rpx; box-sizing: border-box; position: relative; z-index: 1; }

.glass-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-light);
}

/* 路线卡片 */
.route-card { position: relative; overflow: hidden; }
.route-row { display: flex; align-items: center; margin-bottom: 24rpx; }
.route-point { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.dot { width: 18rpx; height: 18rpx; border-radius: 50%; margin-bottom: 8rpx; }
.dot-from { background: var(--primary); }
.dot-to { background: var(--warning); }
.route-text { font-size: var(--font-md); font-weight: 600; max-width: 240rpx; color: var(--text-primary); }
.route-line { flex: 1; height: 2rpx; margin: 0 16rpx; margin-top: 26rpx;
  background: repeating-linear-gradient(to right, var(--border) 0rpx, var(--border) 6rpx, transparent 6rpx, transparent 12rpx);
}
.route-meta { display: flex; gap: 24rpx; margin-bottom: 16rpx; }
.meta-item {
  display: flex; align-items: center; gap: 8rpx;
  font-size: var(--font-sm); color: var(--text-secondary);
}

/* 线条图标：时钟 */
.meta-clock {
  width: 24rpx; height: 24rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 50%;
  position: relative;
}
.meta-clock::after {
  content: ''; position: absolute; top: 4rpx; left: 50%;
  width: 2rpx; height: 7rpx;
  background: var(--text-secondary);
  transform-origin: bottom center;
  transform: translateX(-50%) rotate(30deg);
}

/* 线条图标：人群 */
.meta-people {
  width: 24rpx; height: 24rpx;
  position: relative;
}
.meta-people::before {
  content: ''; position: absolute; top: 0; left: 50%;
  transform: translateX(-50%);
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  border: 2rpx solid var(--text-secondary);
}
.meta-people::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%);
  width: 16rpx; height: 10rpx;
  border: 2rpx solid var(--text-secondary);
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}

.type-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: var(--font-sm);
  font-weight: 500;
}
.type-badge.offer { background: rgba(0,166,147,0.12); color: var(--primary); }
.type-badge.find { background: var(--warning-bg-mid); color: var(--warning); }

/* 区块标题 */
.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--text-primary);
}

/* 用户信息 */
.user-row { display: flex; align-items: center; }
.avatar {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: var(--card-inner-bg-3);
}
.avatar-sm {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: var(--card-inner-bg-3);
}
.user-info { flex: 1; }
.user-name { font-size: var(--font-md); font-weight: 600; color: var(--text-primary); }
.user-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 8rpx; }
.tag {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  background: var(--card-inner-bg-2);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* 私信按钮 */
.contact-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--primary-bg);
  border: 1rpx solid var(--primary-border);
  color: var(--primary);
  font-size: var(--font-sm);
  transition: all 0.2s;
}
.contact-btn:active {
  background: var(--primary-bg-strong);
}

/* 聊天线条图标 */
.chat-line-icon { position: relative; width: 28rpx; height: 24rpx; }
.cli-bubble {
  position: absolute; top: 0; left: 0;
  width: 28rpx; height: 20rpx;
  border: 2rpx solid var(--primary);
  border-radius: 8rpx;
}
.cli-bubble::after {
  content: ''; position: absolute; bottom: -6rpx; left: 6rpx;
  width: 0; height: 0;
  border-left: 4rpx solid transparent;
  border-right: 4rpx solid transparent;
  border-top: 6rpx solid var(--primary);
}
.cli-dot {
  position: absolute; top: 8rpx;
  width: 3rpx; height: 3rpx;
  border-radius: 50%;
  background: var(--primary);
}
.cli-dot-1 { left: 8rpx; }
.cli-dot-2 { left: 15rpx; }

/* 标签 */
.tag-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--card-inner-bg-2);
  font-size: var(--font-sm);
  color: var(--text-secondary);
  border: 1rpx solid var(--border);
}

.note-text { font-size: var(--font-md); color: var(--text-secondary); line-height: 1.7; }

/* 路线详情（出发/目的地细节） */
.route-detail-row {
  display: flex;
  gap: 12rpx;
  font-size: var(--font-xs);
  color: var(--text-hint);
  margin-top: 8rpx;
}
.route-detail-label { flex-shrink: 0; min-width: 140rpx; }

/* 状态徽章 */
.status-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: var(--font-xs);
  font-weight: 500;
  background: var(--card-inner-bg-3);
  color: var(--text-secondary);
  margin-left: auto;
}
.status-badge.status-active { background: rgba(0,166,147,.12); color: var(--primary); }
.status-badge.status-full { background: rgba(255,159,10,.12); color: var(--warning); }
.status-badge.status-ended { background: var(--card-inner-bg-3); color: var(--text-hint); }
.status-badge.status-cancelled,
.status-badge.status-expired { background: rgba(255,69,58,.12); color: var(--danger); }

/* 行程信息 */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.info-row:last-child { border-bottom: none; }
.info-label {
  font-size: var(--font-sm);
  color: var(--text-hint);
  width: 160rpx;
  flex-shrink: 0;
}
.info-value {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-primary);
  word-break: break-word;
}
.price-value {
  color: var(--warning);
  font-weight: 600;
  font-size: var(--font-md);
}

/* 图片九宫格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.grid-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  background: var(--card-inner-bg-2);
}

.participant-list { display: flex; flex-wrap: wrap; gap: 24rpx; }
.participant-item { display: flex; align-items: center; }
.participant-name { font-size: var(--font-sm); color: var(--text-secondary); }

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0 48rpx;
  align-items: center;
}

.btn-primary {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: 999rpx;
  font-size: var(--font-lg);
  font-weight: 600;
}

.btn-outline-sm {
  flex: 1;
  text-align: center;
  padding: 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border);
  color: var(--text-primary);
  font-size: var(--font-md);
  transition: all 0.2s;
}
.btn-outline-sm:active { background: var(--card-inner-bg-2); }
.btn-outline-sm.danger { border-color: rgba(255,69,58,.3); color: var(--danger); }

.btn-fav {
  width: 88rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  transition: all 0.2s;
}
.btn-fav:active { background: var(--card-inner-bg-2); }
.btn-fav.active { border-color: var(--warning); }

/* 星形线条图标 */
.fav-star {
  width: 32rpx; height: 32rpx;
  position: relative;
}
.fav-star::before {
  content: '';
  position: absolute;
  inset: 0;
  background: transparent;
  border: 3rpx solid var(--text-hint);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}
.fav-star.filled::before {
  background: var(--warning);
  border-color: var(--warning);
}

/* 评价按钮 */
.review-btns { display: flex; flex-direction: column; gap: 14rpx; }
.btn-outline {
  text-align: center;
  padding: 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border);
  color: var(--text-primary);
  font-size: var(--font-md);
  transition: all 0.2s;
}
.btn-outline:active { background: var(--card-inner-bg-2); }

/* 空状态 */
.loading { text-align: center; padding: 120rpx 0; color: var(--text-hint); font-size: var(--font-md); }
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 0;
}
.empty-icon {
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  background: var(--card-inner-bg);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}
.empty-icon text { font-size: 40rpx; }
.empty-text {
  font-size: var(--font-lg);
  color: var(--text-secondary);
}

/* Inbox empty icon */
.ei-inbox { width: 40rpx; height: 32rpx; border: 3rpx solid var(--text-hint); border-radius: 4rpx; position: relative; }
.ei-inbox::before { content: ""; position: absolute; top: -6rpx; left: 50%; transform: translateX(-50%); width: 24rpx; height: 12rpx; border: 3rpx solid var(--text-hint); border-bottom: none; border-radius: 6rpx 6rpx 0 0; background: var(--bg-card); }

/* ========== 模块帖子详情 ========== */
.module-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.module-detail-title {
  flex: 1;
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
}
.module-detail-type {
  margin-top: 12rpx;
  font-size: var(--font-sm);
  color: var(--text-hint);
}
.create-time-text {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-xs);
  color: var(--text-hint);
}
