/* pages/announcement/announcement.wxss */
page { background: transparent !important; }
.page-announcement { min-height: 100vh; background: transparent !important; }

/* 内容区 */
.content { min-height: 100vh; padding: 24rpx 32rpx; box-sizing: border-box; position: relative; z-index: 1; }

/* 公告卡片 */
.ann-top { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.ann-title { font-size: var(--font-lg); font-weight: 600; flex: 1; }
.ann-badge { font-size: var(--font-xs); padding: 4rpx 16rpx; border-radius: 999rpx; background: var(--warning-border); color: var(--warning); }
.ann-summary { font-size: var(--font-sm); color: var(--text-secondary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.ann-footer { display: flex; justify-content: space-between; margin-top: 16rpx; }
.ann-time { font-size: var(--font-xs); color: var(--text-hint); }
.ann-views { font-size: var(--font-xs); color: var(--text-hint); }

/* ===== 公告详情弹窗 ===== */
.ann-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity .25s;
}
.ann-modal.show {
  opacity: 1;
  pointer-events: auto;
}
.ann-modal-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.45);
}
.ann-modal-card {
  position: relative;
  width: 100%;
  max-height: 75vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform .3s ease;
}
.ann-modal.show .ann-modal-card {
  transform: translateY(0);
}
.ann-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.ann-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
  padding-right: 20rpx;
}
.ann-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-hint);
  border-radius: 50%;
  background: #f5f5f5;
  flex-shrink: 0;
}
.ann-modal-body {
  flex: 1;
  padding: 28rpx 36rpx;
  overflow-y: auto;
}
.ann-modal-content {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.8;
  white-space: pre-wrap;
}
.ann-modal-meta {
  display: flex;
  gap: 24rpx;
  padding: 16rpx 36rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.ann-modal-actions {
  padding: 20rpx 36rpx 40rpx;
  flex-shrink: 0;
}
.ann-modal-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #FF9500, #FF6B35);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
