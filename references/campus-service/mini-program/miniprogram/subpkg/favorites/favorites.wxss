/* pages/favorites/favorites.wxss */
.page-fav { min-height: 100vh; background: transparent; }
.content { min-height: 100vh; padding: 24rpx 32rpx; box-sizing: border-box; }
.carpool-card { position: relative; }
.card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.route { font-size: var(--font-lg); font-weight: 600; }
.type-badge { font-size: var(--font-xs); padding: 6rpx 20rpx; border-radius: 999rpx; }
.type-badge.offer { background: rgba(0,166,147,0.15); color: var(--primary); }
.type-badge.find { background: var(--warning-border); color: var(--warning); }
.card-meta { display: flex; gap: 24rpx; font-size: var(--font-sm); color: var(--text-secondary); margin-bottom: 12rpx; }
.card-note { font-size: var(--font-sm); color: var(--text-hint); }
.unfav-btn { margin-top: 16rpx; font-size: var(--font-sm); color: var(--danger); text-align: right; }

/* ========== 模块收藏卡片 ========== */
.module-card { position: relative; margin-bottom: 20rpx; }

.mod-fav-top { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }

.mod-fav-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--primary-bg-strong);
  color: var(--primary);
  font-weight: 500;
}

.mod-fav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.mod-fav-meta { display: flex; align-items: center; gap: 16rpx; margin-bottom: 8rpx; }

.mod-fav-price { font-size: 26rpx; font-weight: 700; color: var(--warning); }

.mod-fav-loc { font-size: 22rpx; color: var(--text-hint); }

.mod-fav-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.mod-fav-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border);
}

.mod-fav-time { font-size: var(--font-xs); color: var(--text-hint); }

/* ===== 顶部 bar：二手鸭鸭Logo（沿用 secondhand） ===== */
.msg-top-bar {
  position: relative; z-index: 100;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}
.msg-top-bar .top-bar-inner {
  height: 44px; display: flex; align-items: center; padding: 0 24rpx; position: relative;
}
.msg-top-bar .nav-back {
  width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center;
}
.msg-top-bar .back-arrow {
  width: 20rpx; height: 20rpx;
  border-left: 4rpx solid #333; border-bottom: 4rpx solid #333;
  transform: rotate(45deg); margin-left: 8rpx;
}
.msg-top-bar .brand-logo {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  display: flex; align-items: center; gap: 12rpx;
}
.msg-top-bar .brand-name { font-size: 32rpx; font-weight: 700; color: #333; letter-spacing: 1rpx; }
.msg-top-bar .top-duck-icon { position: relative; width: 36rpx; height: 36rpx; }
.msg-top-bar .td-head  { position: absolute; top: 4rpx; left: 6rpx; width: 22rpx; height: 22rpx; background: #FFC54A; border-radius: 50%; }
.msg-top-bar .td-eye   { position: absolute; top: 12rpx; left: 18rpx; width: 4rpx; height: 4rpx; background: #333; border-radius: 50%; }
.msg-top-bar .td-beak  { position: absolute; top: 18rpx; left: 24rpx; width: 8rpx; height: 5rpx; background: #FF9500; border-radius: 0 4rpx 4rpx 0; }
.msg-top-bar .td-body  { position: absolute; bottom: 0; left: 4rpx; width: 28rpx; height: 18rpx; background: #FFFFFF; border-radius: 14rpx 14rpx 12rpx 12rpx; border: 2rpx solid #FFC54A; box-sizing: border-box; }
.msg-top-bar .td-wing  { position: absolute; bottom: 6rpx; left: 14rpx; width: 12rpx; height: 8rpx; background: #FFE0A0; border-radius: 6rpx; }
.msg-top-bar .td-tail  { position: absolute; bottom: 8rpx; left: 0; width: 6rpx; height: 6rpx; background: #FFFFFF; border: 2rpx solid #FFC54A; border-radius: 50%; box-sizing: border-box; }
.msg-top-bar-spacer { width: 100%; }
