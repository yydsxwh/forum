.fi-icon {
  width: 28rpx;
  height: 28rpx;
  position: relative;
  flex-shrink: 0;
}
.fi-yuan {
  border: 3rpx solid var(--text-secondary);
  border-radius: 50%;
}
.fi-yuan::after {
  content: '¥';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  font-size: 14rpx;
  color: var(--text-secondary);
  line-height: 1;
}
.fi-ruler {
  border-bottom: 3rpx solid var(--text-secondary);
  border-left: 3rpx solid var(--text-secondary);
  border-radius: 0 0 0 4rpx;
  width: 24rpx;
  height: 16rpx;
}
.fi-ruler::before {
  content: ''; position: absolute; top: 0; left: 4rpx;
  width: 3rpx; height: 8rpx;
  background: var(--text-secondary);
}
.fi-ruler::after {
  content: ''; position: absolute; top: 0; left: 12rpx;
  width: 3rpx; height: 8rpx;
  background: var(--text-secondary);
}
.fi-clock {
  border: 3rpx solid var(--text-secondary);
  border-radius: 50%;
}
.fi-clock::after {
  content: ''; position: absolute; top: 4rpx; left: 50%;
  width: 2rpx; height: 8rpx;
  background: var(--text-secondary);
  transform-origin: bottom center;
  transform: translateX(-50%);
}
.fi-calendar {
  border: 3rpx solid var(--text-secondary);
  border-radius: 4rpx;
}
.fi-calendar::before {
  content: ''; position: absolute; top: -6rpx; left: 4rpx;
  width: 3rpx; height: 6rpx;
  background: var(--text-secondary);
}
.fi-calendar::after {
  content: ''; position: absolute; top: -6rpx; right: 4rpx;
  width: 3rpx; height: 6rpx;
  background: var(--text-secondary);
}
.fi-people {
  width: 28rpx; height: 28rpx;
}
.fi-people::before {
  content: ''; position: absolute; top: 0; left: 50%;
  transform: translateX(-50%);
  width: 10rpx; height: 10rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 50%;
}
.fi-people::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%);
  width: 20rpx; height: 12rpx;
  border: 3rpx solid var(--text-secondary);
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
}
.fi-phone {
  border: 3rpx solid var(--text-secondary);
  border-radius: 4rpx;
  width: 18rpx;
  height: 26rpx;
}
.fi-phone::after {
  content: ''; position: absolute; bottom: 3rpx; left: 50%;
  transform: translateX(-50%);
  width: 6rpx; height: 3rpx;
  border-radius: 2rpx;
  background: var(--text-secondary);
}
.fi-note {
  border: 3rpx solid var(--text-secondary);
  border-radius: 4rpx;
  width: 24rpx;
  height: 28rpx;
}
.fi-note::after {
  content: ''; position: absolute; top: 6rpx; left: 50%;
  transform: translateX(-50%);
  width: 12rpx; height: 3rpx;
  background: var(--text-secondary);
  box-shadow: 0 6rpx 0 var(--text-secondary);
}

.form-input {
  flex: 1;
  text-align: right;
