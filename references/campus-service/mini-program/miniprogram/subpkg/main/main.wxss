}
.swap-btn {
  width: 64rpx; height: 36rpx;
  border-radius: 18rpx;
  background: var(--primary-bg-mid);
  border: 2rpx solid var(--primary-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 双向交换箭头 */
.swap-icon-double {
  width: 4rpx;
  height: 24rpx;
  background: var(--primary);
  border-radius: 2rpx;
  position: relative;
}
.swap-icon-double::before {
  content: '';
  position: absolute;
  top: -5rpx;
  left: -8rpx;
  width: 0; height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 10rpx solid var(--primary);
}
.swap-icon-double::after {
  content: '';
  position: absolute;
  bottom: -5rpx;
  left: -8rpx;
  width: 0; height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid var(--primary);
}
.swap-hori-icon {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.shi-left, .shi-right {
  position: relative;
  width: 3rpx;
  height: 16rpx;
  background: var(--primary);
  border-radius: 2rpx;
}
.shi-left::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  border-left: 3rpx solid var(--primary);
  border-top: 3rpx solid var(--primary);
  transform: translateX(-50%) rotate(45deg);
}
.shi-right::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  border-left: 3rpx solid var(--primary);
  border-bottom: 3rpx solid var(--primary);
  transform: translateX(-50%) rotate(-45deg);
}
.swap-line-icon { position: relative; width: 24rpx; height: 40rpx; }
.sli-arrow-up {
  position: absolute; top: 0; left: 50%;
  transform: translateX(-50%);
  width: 3rpx; height: 14rpx;
  background: var(--primary);
}
.sli-arrow-up::before {
  content: ''; position: absolute; top: 0; left: 50%;
  width: 10rpx; height: 10rpx;
  border-left: 3rpx solid var(--primary);
  border-top: 3rpx solid var(--primary);
  transform: translateX(-50%) rotate(45deg);
}
.sli-arrow-down {
  position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%);
  width: 3rpx; height: 14rpx;
  background: var(--primary);
}
.sli-arrow-down::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  width: 10rpx; height: 10rpx;
  border-right: 3rpx solid var(--primary);
