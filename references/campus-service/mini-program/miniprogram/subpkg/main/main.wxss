/* pages/main/main.wxss — 四合一主页面样式 */

/* ===== 布局 ===== */
.page-main {
  height: 100vh;
  overflow: hidden;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}

/* ===== 统一顶部导航栏 ===== */
.main-top-bar {
  background: var(--topbar-gradient);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid var(--border-light);
  flex-shrink: 0;
  z-index: 10;
}
.brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}
.brand-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.brand-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}
.brand-name {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}
.brand-right {
  position: relative;
  margin-right: 220rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 铃铛图标 */
.bell-line-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}
.bell-body {
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 18rpx;
  border: 2rpx solid var(--text-hint);
  border-radius: 10rpx 10rpx 4rpx 4rpx;
}
.bell-clapper {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 3rpx;
  background: var(--text-hint);
  border-radius: 1rpx;
}
.bell-dot {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--danger);
  border: 2rpx solid var(--bg-card);
}

/* 鸭子logo */
.duck-icon { position: relative; width: 42rpx; height: 42rpx; transform: scaleX(-1); }
.duck-head {
  position: absolute; top: 4rpx; left: 4rpx;
  width: 18rpx; height: 16rpx;
  border-radius: 50%;
  border: 2rpx solid var(--primary);
}
.duck-eye {
  position: absolute; top: 8rpx; right: 22rpx;
  width: 3rpx; height: 3rpx;
  border-radius: 50%; background: var(--primary);
}
.duck-beak {
  position: absolute; top: 10rpx; left: 0;
  width: 10rpx; height: 5rpx;
  border-radius: 0 5rpx 5rpx 0;
  background: var(--warning);
}
.duck-body {
  position: absolute; bottom: 2rpx; left: 6rpx;
  width: 28rpx; height: 20rpx;
  border-radius: 50% 50% 40% 40%;
  border: 2rpx solid var(--primary);
  background: var(--primary-bg-mid);
}
.duck-wing {
  position: absolute; bottom: 8rpx; left: 20rpx;
  width: 12rpx; height: 8rpx;
  border-radius: 50%;
  border: 2rpx solid var(--primary);
  transform: rotate(-20deg);
}
.duck-tail {
  position: absolute; bottom: 12rpx; right: 2rpx;
  width: 7rpx; height: 7rpx;
  border-left: 2rpx solid var(--primary);
  border-bottom: 2rpx solid var(--primary);
  transform: rotate(45deg);
}

/* ===== Swiper ===== */
.main-swiper {
  flex: 1;
  height: 0;
}
.tab-scroll {
  height: 100%;
  padding: 16rpx 0 0;
  box-sizing: border-box;
}
.tab-bottom-space {
  height: 60rpx;
}

/* ===== 底部 TabBar ===== */
.main-tabbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  background: var(--nav-bg-2);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--border-light);
  padding: 10rpx 16rpx;
  flex-shrink: 0;
  z-index: 10;
}
.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 20rpx;
  transition: all 0.2s;
  min-width: 120rpx;
}
.tabbar-item:active {
  opacity: 0.8;
}
.tb-label {
  font-size: 20rpx;
  color: var(--text-hint);
  transition: color 0.2s;
}
.tabbar-item.active .tb-label {
  color: var(--primary);
  font-weight: 600;
}

/* TabBar 图标 */
.tb-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 图标: 首页 */
.tbi-house-roof {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 14rpx solid var(--text-hint);
}
.tbi-house-body {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 18rpx;
  border: 2rpx solid var(--text-hint);
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
}
.tabbar-item.active .tbi-house-roof {
  border-bottom-color: var(--primary);
}
.tabbar-item.active .tbi-house-body {
  border-color: var(--primary);
}

/* 图标: 发布 (加号) */
.tbi-plus-h {
  position: absolute;
  width: 24rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--text-hint);
}
.tbi-plus-v {
  position: absolute;
  width: 4rpx;
  height: 24rpx;
  border-radius: 2rpx;
  background: var(--text-hint);
}
.tabbar-item.active .tbi-plus-h,
.tabbar-item.active .tbi-plus-v {
  background: var(--primary);
}

/* 图标: 消息 (气泡) */
.tbi-chat-bubble {
  width: 32rpx;
  height: 24rpx;
  border: 2px solid var(--text-hint);
  border-radius: 10rpx;
  position: relative;
}
.tbi-chat-bubble::after {
  content: '';
  position: absolute;
  bottom: -7rpx;
  left: 6rpx;
  width: 0;
  height: 0;
  border-left: 4rpx solid transparent;
  border-right: 4rpx solid transparent;
  border-top: 7rpx solid var(--text-hint);
}
.tabbar-item.active .tbi-chat-bubble {
  border-color: var(--primary);
}
.tabbar-item.active .tbi-chat-bubble::after {
  border-top-color: var(--primary);
}
.tbi-msg-badge {
  position: absolute;
  top: -10rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  padding: 0 8rpx;
  z-index: 1;
}

/* 图标: 我的 (人形) */
.tbi-head {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 12rpx;
  border: 2px solid var(--text-hint);
  border-radius: 50%;
}
.tbi-body {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 14rpx;
  border: 2px solid var(--text-hint);
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
}
.tabbar-item.active .tbi-head,
.tabbar-item.active .tbi-body {
  border-color: var(--primary);
}

/* ============ 以下是各页面移植样式 ============ */

/* ---------- Hall 首页大厅 ---------- */
.route-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
  border-radius: 54rpx;
  height: 78rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--border-light);
  flex: 1;
  min-width: 0;
  align-self: center;
}
.route-row {
  margin: 0 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.route-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}
.route-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.from-dot { background: var(--primary); }
.to-dot { background: var(--warning); }
.route-text {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.route-swap {
  margin: 0 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--card-inner-bg-2);
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.swap-icon-h, .swap-icon-v {
  position: absolute;
  width: 14rpx;
  height: 3rpx;
  background: var(--text-hint);
  border-radius: 2rpx;
}
.swap-icon-h::after {
  content: ''; position: absolute; top: -4rpx; right: 0;
  width: 6rpx; height: 6rpx;
  border-right: 2px solid var(--text-hint);
  border-top: 2px solid var(--text-hint);
  transform: rotate(45deg);
}
.swap-icon-v::after {
  content: ''; position: absolute; bottom: -4rpx; right: 0;
  width: 6rpx; height: 6rpx;
  border-right: 2px solid var(--text-hint);
  border-top: 2px solid var(--text-hint);
  transform: rotate(-135deg);
}

.filter-scroll {
  margin: 16rpx 0;
  padding: 0 32rpx;
}
.filter-tags {
  display: flex;
  gap: 14rpx;
  white-space: nowrap;
}
.filter-chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
  font-size: var(--font-sm);
  color: var(--text-secondary);
  background: var(--card-inner-bg);
  transition: all 0.2s;
  display: inline-flex;
}
.filter-chip.active {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
  font-weight: 600;
}

.hot-routes {
  padding: 8rpx 32rpx 16rpx;
}
.hot-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-bottom: 14rpx;
}
.hot-flame {
  width: 20rpx;
  height: 24rpx;
  background: var(--warning);
  clip-path: polygon(50% 0%, 90% 40%, 80% 80%, 50% 100%, 20% 80%, 10% 40%);
}
.hot-list {
  display: flex;
  gap: 14rpx;
  white-space: nowrap;
}
.hot-item {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--warning-bg);
  border: 1rpx solid var(--warning-border);
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}
.hot-route-name {
  font-size: var(--font-sm);
  color: var(--warning);
}
.hot-route-count {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

/* 卡片列表 */
.carpool-list {
  padding: 0 32rpx;
}
.carpool-card {
  background: var(--bg-card);
  border-radius: 44rpx !important;
  padding: 30rpx 40rpx !important;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-light);
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.card-time {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.time-text {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
}
.time-ago {
  font-size: var(--font-xs);
  color: var(--text-hint);
}
.card-type {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: var(--font-xs);
  font-weight: 500;
}
.type-offer {
  background: var(--primary-bg);
  color: var(--primary);
}
.type-find {
  background: var(--warning-bg-mid);
  color: var(--warning);
}

/* 路线统一区块 */
.route-block {
  display: flex;
  align-items: flex-start;
  margin-bottom: 46rpx;
  padding: 28rpx 36rpx;
  background: var(--input-bg-2);
  border-radius: 44rpx;
  border: 1rpx solid var(--input-bg-2);
}
.route-line {
  position: relative;
  width: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  align-self: stretch;
}
.line-dot {
  position: absolute;
  left: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}
.start-dot { top: 12rpx; background: var(--primary); }
.end-dot { bottom: 12rpx; background: var(--warning); }
.line-dash {
  position: absolute;
  left: 6rpx;
  top: 26rpx;
  bottom: 26rpx;
  width: 2rpx;
  background: repeating-linear-gradient(to bottom, var(--border) 0, var(--border) 4rpx, transparent 4rpx, transparent 10rpx);
}
.route-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  position: relative;
}
.route-from {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.2;
}
.route-to {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.2;
}
.route-seats {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  text-align: right;
}
.seats-left {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
}
.seats-total {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--text-hint);
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid var(--border-light);
  padding-top: 16rpx;
  gap: 20rpx;
}
.creator-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.creator-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--card-inner-bg-3);
}
.creator-name-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.creator-name {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-primary);
}
.verified-badge {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--primary-bg-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}
.check-icon {
  width: 12rpx;
  height: 7rpx;
  border-left: 2px solid var(--primary);
  border-bottom: 2px solid var(--primary);
  transform: rotate(-45deg);
  margin-top: -2rpx;
}
.creator-credit {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-hint);
}
/* 备注 & 个性标签 */
.card-notes {
  padding: 0 0 8rpx;
  margin-bottom: 10rpx;
  border-bottom: 1rpx solid var(--border-light);
}
.card-note-text {
  font-size: var(--font-xs);
  color: var(--text-hint);
  line-height: 1.5;
  display: block;
  margin-bottom: 12rpx;
  padding-left: 0.5em;
}
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.tag-item {
  font-size: var(--font-xs);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 500;
}
/* 4色循环 */
.tag-c0 { color: #00A693; background: var(--primary-bg); }
.tag-c1 { color: #FF6B8A; background: var(--pink-bg); }
.tag-c2 { color: var(--warning); background: var(--warning-bg-mid); }
.tag-c3 { color: #5E8BFF; background: var(--blue-bg); }
.action-row {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.btn-detail {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border);
  color: var(--text-secondary);
  font-size: var(--font-md);
  font-weight: 500;
}
.btn-detail.full-width {
  width: 100%;
  color: var(--text-hint);
  background: var(--input-bg-2);
}
.btn-detail.full-width.btn-joined-pulse {
  color: #fff;
  background: var(--primary);
  border-color: var(--primary);
  animation: joinedPulse 2s ease-in-out infinite;
}
.btn-join.btn-joined-pulse {
  animation: joinedPulse 2s ease-in-out infinite;
}
@keyframes joinedPulse {
  0%, 100% { box-shadow: 0 0 0 0 var(--primary-border); }
  50% { box-shadow: 0 0 0 10rpx rgba(0,166,147,0); }
}
.btn-join {
  flex: 1;
  text-align: center;
  padding: 18rpx;
}

/* 历史行程 */
.history-section {
  margin-top: 20rpx;
}
.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: var(--input-bg-2);
  border-radius: var(--radius-md);
  margin: 0 32rpx 16rpx;
}
.history-title {
  font-size: var(--font-sm);
  color: var(--text-hint);
  font-weight: 500;
}
.history-sub {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
  margin-left: 8rpx;
  flex: 1;
}
.history-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid var(--text-hint);
  border-bottom: 2rpx solid var(--text-hint);
  transform: rotate(-45deg);
  transition: transform .2s;
}
.history-arrow.expanded {
  transform: rotate(45deg);
}

/* ========== 首页模块网格 ========== */
.home-banner-wrap {
  margin: 16rpx 32rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.08);
}
.home-banner {
  width: 100%;
  height: 260rpx;
}
.home-banner swiper-item { height: 260rpx; }
.banner-card {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}
.banner-0 { background: linear-gradient(135deg, var(--primary), #009980); }
.banner-1 { background: linear-gradient(135deg, #5E8BFF, #3D6CE6); }
.banner-2 { background: linear-gradient(135deg, #FF8C5E, #E8693A); }
.banner-text { display: flex; flex-direction: column; gap: 8rpx; }
.banner-title { font-size: var(--font-xl); font-weight: 700; color: #fff; }
.banner-sub { font-size: var(--font-sm); color: rgba(255,255,255,.8); }

/* 公告通知条 */
.home-notice-bar {
  margin: 16rpx 32rpx 0;
  padding: 16rpx 24rpx;
  background: var(--warning-bg);
  border: 1rpx solid var(--warning-border);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
}
.notice-icon-box { flex-shrink: 0; display: flex; align-items: center; }
.notice-bell-sm {
  width: 28rpx; height: 30rpx; border: 2rpx solid var(--warning);
  border-radius: 6rpx 6rpx 2rpx 2rpx; position: relative;
}
.notice-bell-sm::after {
  content: ""; position: absolute; bottom: -8rpx; left: 50%;
  transform: translateX(-50%); width: 8rpx; height: 4rpx;
  background: var(--warning); border-radius: 0 0 4rpx 4rpx;
}
.notice-scroll-text {
  font-size: var(--font-sm);
  color: var(--warning);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

/* 功能模块网格 */
.home-module-grid {
  margin: 20rpx 32rpx;
  padding: 16rpx 0;
  background: var(--bg-card);
  border-radius: 32rpx;
  display: flex;
  flex-wrap: wrap;
}
.home-module-grid.card {
  padding: 28rpx 8rpx 16rpx;
  margin-bottom: 0;
}
.module-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
  gap: 12rpx;
}
.module-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.module-0 { background: #E8F8F5; }
.module-1 { background: #FFF0E8; }
.module-2 { background: #E8F0FF; }
.module-3 { background: #FFE8F0; }
.module-4 { background: #F0E8FF; }
.module-5 { background: #E8FFE8; }
.module-6 { background: #E8F8F5; }
.module-7 { background: #FFF8E8; }
.module-8 { background: #E8F0FF; }
.module-9 { background: #FFE8E8; }
.module-10 { background: #FFF0E8; }
.module-11 { background: #FFE8F0; }
.module-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  text-align: center;
}

/* 首页通知公告卡片 */
.home-notices.card-section {
  margin: 0 32rpx 16rpx;
  background: var(--bg-card);
  border-radius: 32rpx;
  padding: 28rpx;
  border: 1rpx solid var(--border-light);
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title-row { display: flex; align-items: center; gap: 10rpx; }
.section-icon { display: flex; align-items: center; }
.si-megaphone-sec { width: 28rpx; height: 24rpx; border: 2rpx solid var(--warning); border-radius: 4rpx 2rpx 2rpx 4rpx; position: relative; }
.si-megaphone-sec::after { content: ""; position: absolute; right: -6rpx; top: 50%; transform: translateY(-50%); width: 14rpx; height: 10rpx; background: var(--warning); clip-path: polygon(0 0, 100% 50%, 0 100%); }
.section-title { font-size: var(--font-md); font-weight: 600; color: var(--text-primary); }
.section-more { font-size: var(--font-xs); color: var(--primary); }
.notice-list { display: flex; flex-direction: column; gap: 12rpx; }
.notice-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 20rpx; background: var(--bg-page); border-radius: 16rpx; }
.notice-dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
.dot-notice { background: var(--primary); }
.dot-bulletin { background: var(--danger); }
.notice-item-text { font-size: var(--font-sm); color: var(--text-secondary); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ========== 模块CSS图标 ========== */
/* 取快递 */
.mi-package { position: relative; width: 44rpx; height: 40rpx; }
.mi-pkg-body { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 40rpx; height: 28rpx; border: 3rpx solid var(--primary); border-radius: 6rpx; background: rgba(0,166,147,.12); }
.mi-pkg-lid { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 44rpx; height: 12rpx; border: 3rpx solid var(--primary); border-radius: 6rpx 6rpx 0 0; background: rgba(0,166,147,.2); }
/* 大厅任务 */
.mi-target { position: relative; width: 42rpx; height: 42rpx; }
.mi-tgt-outer { position: absolute; inset: 0; border: 3rpx solid #FF8C5E; border-radius: 50%; }
.mi-tgt-inner { position: absolute; inset: 10rpx; border: 2rpx solid #FF8C5E; border-radius: 50%; background: rgba(255,140,94,.1); }
.mi-tgt-cross-h { position: absolute; top: 50%; left: 0; width: 100%; height: 2rpx; background: #FF8C5E; transform: translateY(-50%); }
.mi-tgt-cross-v { position: absolute; left: 50%; top: 0; height: 100%; width: 2rpx; background: #FF8C5E; transform: translateX(-50%); }
/* 失物招领 */
.mi-search { position: relative; width: 42rpx; height: 42rpx; }
.mi-sr-glass { position: absolute; top: 2rpx; left: 2rpx; width: 30rpx; height: 30rpx; border: 3rpx solid #5E8BFF; border-radius: 50%; }
.mi-sr-handle { position: absolute; bottom: 4rpx; right: 4rpx; width: 3rpx; height: 16rpx; background: #5E8BFF; border-radius: 2rpx; transform: rotate(-45deg); transform-origin: top center; }
/* 校园论坛 */
.mi-chat { position: relative; width: 42rpx; height: 36rpx; }
.mi-ct-bubble { position: absolute; inset: 0; background: #FF6B8A; border-radius: 12rpx 12rpx 12rpx 4rpx; }
.mi-ct-dots { position: absolute; left: 12rpx; top: 12rpx; display: flex; gap: 6rpx; }
.mi-ct-dots::before,.mi-ct-dots::after { content: ""; width: 6rpx; height: 6rpx; background: #fff; border-radius: 50%; opacity: .8; }
/* 二手市集 */
.mi-swap { position: relative; width: 42rpx; height: 42rpx; }
.mi-sw-a { position: absolute; top: 4rpx; left: 4rpx; width: 22rpx; height: 22rpx; border: 3rpx solid #8B5EFF; border-radius: 6rpx; background: rgba(139,94,255,.1); }
.mi-sw-b { position: absolute; bottom: 4rpx; right: 4rpx; width: 22rpx; height: 22rpx; border: 3rpx solid #8B5EFF; border-radius: 6rpx; background: rgba(139,94,255,.2); transform: rotate(10deg); }
/* 物品短租 */
.mi-home { position: relative; width: 44rpx; height: 38rpx; }
.mi-hm-roof { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 22rpx solid transparent; border-right: 22rpx solid transparent; border-bottom: 14rpx solid #00A693; }
.mi-hm-body { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 34rpx; height: 24rpx; border: 3rpx solid var(--primary); border-radius: 0 0 4rpx 4rpx; background: rgba(0,166,147,.1); }
/* 校园拼车 */
.mi-car { position: relative; width: 48rpx; height: 32rpx; }
.mi-cr-body { position: absolute; bottom: 0; left: 4rpx; width: 40rpx; height: 22rpx; border: 3rpx solid var(--primary); border-radius: 0 8rpx 8rpx 8rpx; background: rgba(0,166,147,.15); }
.mi-cr-roof { position: absolute; top: 0; left: 12rpx; width: 28rpx; height: 16rpx; border: 3rpx solid var(--primary); border-radius: 10rpx 10rpx 0 0; background: rgba(0,166,147,.2); }
.mi-cr-wl { position: absolute; bottom: -4rpx; left: 12rpx; width: 12rpx; height: 12rpx; border: 3rpx solid var(--text-secondary); border-radius: 50%; background: var(--bg-card); }
.mi-cr-wr { position: absolute; bottom: -4rpx; right: 8rpx; width: 12rpx; height: 12rpx; border: 3rpx solid var(--text-secondary); border-radius: 50%; background: var(--bg-card); }
/* 交换人生 */
.mi-pen { position: relative; width: 36rpx; height: 36rpx; }
.mi-pn-body { position: absolute; bottom: 0; left: 2rpx; width: 32rpx; height: 20rpx; border: 3rpx solid #FF8C5E; border-radius: 4rpx 4rpx 6rpx 6rpx; background: rgba(255,140,94,.1); }
.mi-pn-tip { position: absolute; top: 0; left: 50%; width: 0; height: 0; border-left: 8rpx solid transparent; border-right: 8rpx solid transparent; border-bottom: 12rpx solid #FF8C5E; transform: translateX(-50%); }
/* 打印跑腿 */
.mi-print { position: relative; width: 44rpx; height: 38rpx; }
.mi-pr-body { position: absolute; inset: 0; border: 3rpx solid #5E8BFF; border-radius: 8rpx; background: rgba(94,139,255,.1); }
.mi-pr-paper { position: absolute; top: 6rpx; right: 6rpx; width: 18rpx; height: 6rpx; background: #5E8BFF; border-radius: 2rpx; }
/* 校园黄页 */
.mi-book { position: relative; width: 42rpx; height: 38rpx; }
.mi-bk-cover { position: absolute; right: 0; top: 0; width: 28rpx; height: 38rpx; border: 3rpx solid #FF6B6B; border-radius: 2rpx 6rpx 6rpx 2rpx; background: rgba(255,107,107,.15); }
.mi-bk-line-1 { position: absolute; left: 6rpx; top: 8rpx; width: 14rpx; height: 2rpx; background: #FF6B6B; opacity: .4; }
.mi-bk-line-2 { position: absolute; left: 6rpx; top: 18rpx; width: 10rpx; height: 2rpx; background: #FF6B6B; opacity: .4; }
/* 公告板 */
.mi-megaphone { position: relative; width: 42rpx; height: 36rpx; }
.mi-mp-body { position: absolute; left: 0; top: 4rpx; width: 28rpx; height: 24rpx; border: 3rpx solid #FF8C5E; border-radius: 4rpx 0 0 4rpx; background: rgba(255,140,94,.1); }
.mi-mp-detail { position: absolute; right: 0; top: 8rpx; width: 16rpx; height: 14rpx; background: #FF8C5E; clip-path: polygon(0 0, 100% 50%, 0 100%); }
/* 爱心公益 */
.mi-heart { position: relative; width: 42rpx; height: 36rpx; }
.mi-ht-body { position: absolute; inset: 0; }
.mi-ht-body::before,.mi-ht-body::after { content: ""; position: absolute; top: 0; width: 20rpx; height: 28rpx; border-radius: 10rpx 10rpx 0 0; background: #FF4365; }
.mi-ht-body::before { left: 2rpx; transform: rotate(-45deg); transform-origin: bottom left; }
.mi-ht-body::after { left: 20rpx; transform: rotate(45deg); transform-origin: bottom right; }

/* ---------- Publish 发布 ---------- */
.publish-form {
  padding: 12rpx 32rpx 0;
}
