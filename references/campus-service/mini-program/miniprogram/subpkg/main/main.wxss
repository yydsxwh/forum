.ei-inbox::before { content: ""; position: absolute; top: -6rpx; left: 50%; transform: translateX(-50%); width: 24rpx; height: 12rpx; border: 3rpx solid var(--text-hint); border-bottom: none; border-radius: 6rpx 6rpx 0 0; background: var(--bg-card); }
.ei-chat-bubble { width: 40rpx; height: 30rpx; border: 3rpx solid var(--text-hint); border-radius: 10rpx; position: relative; }
.ei-chat-bubble::after { content: ''; position: absolute; bottom: -8rpx; left: 8rpx; width: 0; height: 0; border-left: 5rpx solid transparent; border-right: 5rpx solid transparent; border-top: 8rpx solid var(--text-hint); }
.loading-more { display: flex; justify-content: center; padding: 32rpx; color: var(--text-hint); font-size: var(--font-sm); }
.no-more { color: var(--text-placeholder); font-size: var(--font-xs); }
.grad-btn { background: var(--primary); color: #fff; border-radius: 999rpx; font-size: var(--font-md); font-weight: 600; }

/* 登录弹窗 */
.login-modal-mask {
  position: fixed;
  inset: 0;
  background: var(--modal-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.login-modal {
  width: 560rpx;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 48rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid var(--border-light);
}
.modal-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.modal-lock { position: relative; width: 36rpx; height: 36rpx; }
.ml-body { position: absolute; bottom: 0; left: 4rpx; width: 28rpx; height: 22rpx; border: 3rpx solid var(--primary); border-radius: 4rpx; }
.ml-shackle { position: absolute; top: 0; left: 8rpx; width: 20rpx; height: 16rpx; border: 3rpx solid var(--primary); border-bottom: none; border-radius: 10rpx 10rpx 0 0; }
.modal-title { font-size: 34rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 12rpx; }
.modal-desc { font-size: 26rpx; color: var(--text-secondary); text-align: center; line-height: 1.6; margin-bottom: 36rpx; }
.modal-btns { display: flex; width: 100%; gap: 20rpx; }
.modal-btn { flex: 1; height: 88rpx; border-radius: 44rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 600; }
.modal-btn:active { transform: scale(.97); }
.modal-btn-cancel { background: var(--card-inner-bg-3); color: var(--text-secondary); border: 1rpx solid var(--border); }
.modal-btn-confirm { background: var(--primary-gradient); color: #fff; }

/* 备案号页脚 */
.page-footer {
  text-align: center;
  padding: 48rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.footer-text {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
}
.footer-icp-text {
  font-size: var(--font-xs);
  color: var(--text-hint);
}


/* ===== 详情弹窗 Overlay ===== */
.overlay-mask {
  position: fixed;
  inset: 0;
  background: var(--overlay-bg);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  transition: opacity .28s;
}
.overlay-mask.visible {
  opacity: 1;
}

.detail-overlay {
  width: 100%;
  max-height: 85vh;
  background: var(--bg-card);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform .28s cubic-bezier(.4,0,.2,1);
  overflow-x: hidden;
  box-sizing: border-box;
}
.detail-overlay.slide-up {
  transform: translateY(0);
}

.overlay-handle {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
  flex-shrink: 0;
}
.handle-bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--border);
}

.overlay-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}
.spinner-small {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--back-btn-bg);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin .8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text {
  font-size: var(--font-sm);
  color: var(--text-hint);
}

.overlay-scroll {
  flex: 1;
  padding: 0 36rpx 24rpx;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 路线 */
.ov-route {
  position: relative;
  padding: 16rpx 0 24rpx;
}
.ov-route-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.ov-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.ov-dot-from { background: var(--primary); }
.ov-dot-to { background: var(--warning); }
.ov-route-text {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ov-route-line {
  position: absolute;
  left: 8rpx;
  top: 42rpx;
  bottom: 48rpx;
  width: 2rpx;
  background: repeating-linear-gradient(to bottom, var(--border) 0, var(--border) 6rpx, transparent 6rpx, transparent 14rpx);
}
.ov-type-badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: var(--font-xs);
  font-weight: 600;
}
.ov-type-badge.offer {
  background: var(--primary-bg);
  color: var(--primary);
}
.ov-type-badge.find {
  background: var(--warning-bg-mid);
  color: var(--warning);
}

/* 信息网格 */
.ov-info-grid {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
  background: var(--border-light);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 20rpx;
}
.ov-info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--bg-page);
}
.ov-info-label {
  font-size: var(--font-sm);
  color: var(--text-hint);
  flex-shrink: 0;
}
.ov-info-val {
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: 500;
  text-align: right;
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
  word-break: break-all;
  overflow-wrap: break-word;
}
.ov-price {
  color: var(--warning);
  font-weight: 600;
}
.ov-status {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: var(--font-xs);
  font-weight: 500;
  background: var(--card-inner-bg-3);
  color: var(--text-secondary);
}
.ov-status-active { background: var(--primary-bg); color: var(--primary); }
.ov-status-full { background: var(--warning-bg-mid); color: var(--warning); }
.ov-status-ended, .ov-status-expired { background: var(--card-inner-bg-2); color: var(--text-hint); }
.ov-status-cancelled { background: rgba(255,69,58,.10); color: var(--danger); }

/* 标签 */
.ov-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.ov-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: var(--font-xs);
  color: var(--text-secondary);
  background: var(--card-inner-bg-2);
  border: 1rpx solid var(--border);
}

/* 图片 */
.ov-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
}
.ov-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-md);
  background: var(--card-inner-bg-2);
  flex-shrink: 0;
}

/* 发布者 */
.ov-creator {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: var(--card-inner-bg);
  border-radius: var(--radius-md);
  margin-bottom: 20rpx;
}
.ov-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--card-inner-bg-3);
}
.ov-creator-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}
.ov-creator-credit {
  font-size: var(--font-xs);
  color: var(--text-hint);
  display: block;
  margin-top: 4rpx;
}

/* 参与者 */
.ov-participants {
  margin-bottom: 20rpx;
}
.ov-section-title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}
.ov-p-item {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.ov-p-name {
  font-size: var(--font-sm);
  color: var(--text-primary);
}
.ov-p-credit {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

/* 操作按钮 */
.ov-actions {
  display: flex;
  gap: 14rpx;
  padding: 16rpx 0;
  flex-wrap: wrap;
  align-items: center;
}
.ov-btn {
  padding: 18rpx 22rpx;
  border-radius: 999rpx;
  font-size: var(--font-sm);
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transition: all .2s;
  white-space: nowrap;
  flex-shrink: 0;
}
.ov-btn:active { opacity: .85; }
.ov-btn-primary {
  flex: 1;
  min-width: 0;
  background: var(--primary);
  color: #fff;
}
.ov-btn-outline {
  flex: 1;
  min-width: 0;
  border: 2rpx solid var(--border);
  color: var(--text-primary);
}
.ov-btn-outline.disabled {
  opacity: .4;
  pointer-events: none;
}
.ov-btn-disabled {
  flex: 1; min-width: 0;
  background: var(--card-inner-bg-3);
  color: var(--text-hint);
  pointer-events: none;
}
.ov-btn-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  padding: 0;
  flex-shrink: 0;
}

/* ===== 加入成功弹窗 ===== */
.join-success-modal {
  width: 100%;
  max-height: 80vh;
  background: var(--bg-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 36rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: slideUpIn .3s ease-out;
}
@keyframes slideUpIn {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.jsm-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}
.jsm-title {
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}
/* 行程小卡片 */
.jsm-trip-card {
  width: 100%;
  background: var(--card-inner-bg);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid var(--border-light);
}
.jsm-trip-route {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.jsm-trip-dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.jsm-trip-dot.from { background: var(--primary); }
.jsm-trip-dot.to { background: var(--danger); }
.jsm-trip-from,
.jsm-trip-to {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}
.jsm-trip-arrow {
  font-size: var(--font-md);
  color: var(--text-hint);
  margin: 0 4rpx;
}
.jsm-trip-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}
.jsm-trip-time,
.jsm-trip-seats {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}
.jsm-trip-contact {
  font-size: var(--font-sm);
  color: var(--primary);
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--border-light);
}
.jsm-btns {
  display: flex;
  width: 100%;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.jsm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: var(--font-md);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .2s;
}
.jsm-btn:active { transform: scale(.97); }
.jsm-btn-group {
  background: var(--primary);
  color: #fff;
}
.jsm-btn-copy {
  background: var(--card-inner-bg-3);
  color: var(--text-secondary);
  border: 1rpx solid var(--border);
}
.jsm-close {
  font-size: var(--font-sm);
  color: var(--text-hint);
  padding: 12rpx 0;
}
/* safe-bottom */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.ov-creator-sub {
  font-size: var(--font-xs);
  color: var(--text-hint);
  display: block;
  margin-top: 4rpx;
}

/* 路线搜索按钮 */
.route-search {
  height: 78rpx;
  width: 100rpx;
  border-radius: 29rpx;
  background: var(--primary);
  color: #fff;
  font-size: var(--font-sm);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid var(--primary-border-mid);
  position: relative;
  top: -10rpx;
}
.route-search.search-cancel {
  background: var(--danger-bg);
  color: var(--highlight-green);
}

/* 地点选择弹窗 */
.location-popup {
  width: 100%;
  background: var(--bg-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 36rpx 48rpx;
  animation: slideUpIn .28s ease-out;
}
.loc-pop-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  text-align: center;
}
.loc-search-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.loc-search-input {
  flex: 1;
  height: 80rpx;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  border: 1rpx solid var(--border-light);
}
.loc-search-btn {
  width: 120rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  background: var(--primary);
  color: #fff;
  font-size: var(--font-md);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.loc-common-title {
  font-size: var(--font-sm);
  color: var(--text-hint);
  margin-bottom: 16rpx;
  font-weight: 500;
}
.loc-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.loc-item {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
  font-size: var(--font-md);
  color: var(--text-secondary);
  background: var(--input-bg-2);
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.loc-item.active {
  border-color: var(--primary);
  background: var(--primary-bg);
  color: var(--primary);
}
.loc-check {
  font-size: 20rpx;
  color: var(--primary);
  font-weight: 700;
}
