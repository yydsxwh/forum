/* pages/feedback/feedback.wxss */
.page-feedback { min-height: 100vh; background: transparent; }

/* 内容区 */
.content { min-height: 100vh; padding: 24rpx 32rpx; box-sizing: border-box; }

/* 反馈列表卡片 */
.card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.card-title { font-size: var(--font-md); font-weight: 600; flex: 1; }
.status-tag { font-size: var(--font-xs); padding: 6rpx 20rpx; border-radius: 999rpx; }
.status-tag.pending { background: var(--warning-border); color: var(--warning); }
.status-tag.handling { background: rgba(0,166,147,0.15); color: var(--primary); }
.status-tag.resolved { background: var(--success-bg); color: var(--success); }
.status-tag.closed { background: rgba(255,255,255,0.1); color: var(--text-hint); }
.card-meta { font-size: var(--font-sm); color: var(--text-secondary); display: block; margin-bottom: 8rpx; }
.card-time { font-size: var(--font-xs); color: var(--text-hint); }

/* 表单 */
.form-content { padding: 24rpx 32rpx; }
.form-group { display: flex; flex-direction: column; gap: 16rpx; }
.form-label { font-size: var(--font-sm); color: var(--text-secondary); font-weight: 600; }
.form-input { height: 80rpx; background: var(--bg-page); border-radius: var(--radius-md); padding: 0 24rpx; font-size: var(--font-md); color: var(--text-primary); }
.form-textarea { height: 200rpx; background: var(--bg-page); border-radius: var(--radius-md); padding: 20rpx 24rpx; font-size: var(--font-md); color: var(--text-primary); }
.picker { height: 80rpx; line-height: 80rpx; background: var(--bg-page); border-radius: var(--radius-md); padding: 0 24rpx; font-size: var(--font-md); color: var(--text-primary); }
.btn-primary { text-align: center; padding: 28rpx; border-radius: 999rpx; background: var(--primary); color: #fff; font-size: var(--font-lg); font-weight: 600; margin: 32rpx 0; box-shadow: 0 6rpx 24rpx rgba(0,166,147,.20); transition: all 0.2s; }
.btn-primary:active { transform: scale(0.97); opacity: 0.92; }

/* 弹窗 */
.detail-mask { position: fixed; top:0; left:0; right:0; bottom:0; background: rgba(0,0,0,0.5); z-index: 999; }
.detail-modal { position: fixed; top:0; left:0; right:0; bottom:0; z-index: 1000; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity .25s ease; }
.detail-modal.show { opacity: 1; pointer-events: auto; }
.detail-card { width: 600rpx; max-height: 70vh; background: #fff; border-radius: 32rpx; padding: 48rpx 36rpx 36rpx; position: relative; box-shadow: 0 20rpx 60rpx rgba(0,0,0,.15); display: flex; flex-direction: column; }
.detail-close { position: absolute; top:20rpx; right:20rpx; width:56rpx; height:56rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; color: #999; border-radius: 50%; background: #f5f5f5; z-index: 2; }
.detail-meta { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.detail-title { display: block; font-size: 34rpx; font-weight: 700; color: #333; margin-bottom: 20rpx; line-height: 1.4; }
.detail-rows { margin-bottom: 16rpx; }
.detail-row { display: block; font-size: 24rpx; color: #888; line-height: 1.8; }
.detail-label { display: block; font-size: 26rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.detail-scroll { max-height: 240rpx; }
.detail-content { font-size: 26rpx; color: #555; line-height: 1.7; white-space: pre-wrap; }
.popup-loading { text-align: center; padding: 48rpx 0; font-size: 26rpx; color: #aaa; }
.fb-card { padding: 24rpx; margin-bottom: 16rpx; }
.empty-state { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #aaa; }
.info-time { font-size: var(--font-xs); color: var(--text-hint); }
