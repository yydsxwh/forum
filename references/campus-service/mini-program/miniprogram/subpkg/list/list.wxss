/* pages/list/list.wxss */
.page-list {
  min-height: 100vh;
  background: var(--primary-bg);
}
.list-scroll { height: 100vh; }
.list-items { padding: 24rpx; }
.list-card {
  background: var(--card-bg);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.card-body { padding: 24rpx; }
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}
.card-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--text-hint);
}
.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}
.list-bottom-safe { height: 40rpx; }
.empty-state {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: var(--text-hint); }
.tap-shrink:active { transform: scale(.96); }
