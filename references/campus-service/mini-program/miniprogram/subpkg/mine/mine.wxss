/* pages/mine/mine.wxss */
.page-mine {
  min-height: 100vh;
  background: var(--bg-page);
}

/* 个人信息卡片 */
.profile-card {
  margin: 0 32rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  position: relative;
  background: rgba(255, 149, 0, 0.55);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,.08);
  margin-top: 100rpx;
}

.profile-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: var(--card-inner-bg-3);
}
.circle-1 {
  width: 200rpx;
  height: 200rpx;
  top: -80rpx;
  right: -40rpx;
}
.circle-2 {
  width: 120rpx;
  height: 120rpx;
  bottom: -30rpx;
  left: -20rpx;
}
.circle-3 {
  width: 60rpx;
  height: 60rpx;
  top: 60rpx;
  right: 120rpx;
}

.profile-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 36rpx 28rpx 28rpx;
  gap: 20rpx;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid var(--avatar-border);
  background: rgba(255,255,255,0.15);
}

/* 昵称首字占位头像 */
.profile-avatar-text {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  border: 3rpx solid var(--avatar-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.profile-avatar-text text {
  font-size: 42rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--avatar-border-sm);
}

/* 人形线条图标 */
.avatar-line-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}
.ali-head {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 3rpx solid var(--avatar-border-lg);
}
.ali-body {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 16rpx;
  border: 3rpx solid var(--avatar-border-lg);
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
}

.profile-info {
  flex: 1;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.profile-name {
  font-size: var(--font-xl);
  font-weight: 700;
  color: #FFFFFF;
}

.verified-badge {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--avatar-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  width: 12rpx;
  height: 7rpx;
  border-left: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(-45deg);
  margin-top: -2rpx;
}

.profile-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.edit-btn {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--avatar-border);
  color: #FFFFFF;
  font-size: var(--font-sm);
  background: transparent;
  transition: all 0.2s;
}

.edit-btn:active {
  background: var(--avatar-bg);
}

.login-arrow {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-line {
  width: 18rpx;
  height: 18rpx;
  border-right: 3rpx solid rgba(255,255,255,0.5);
  border-top: 3rpx solid rgba(255,255,255,0.5);
  transform: rotate(45deg);
  margin-left: -6rpx;
}

/* 统计条 */
.stats-row {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: var(--card-inner-bg-hover);
  border-top: 1rpx solid var(--border-light);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-value {
  font-size: var(--font-xl);
  font-weight: 700;
  color: #FFFFFF;
}

.stat-label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255,255,255,0.15);
}

/* 功能入口 */
.menu-section {
  padding: 28rpx 32rpx 16rpx;
}

.section-label {
  font-size: var(--font-sm);
  color: var(--text-hint);
  margin-bottom: 16rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  position: relative;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  transition: all 0.2s;
}

.menu-item:active {
  background: var(--bg-card-hover);
}

.menu-icon-line {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

/* === 线条图标：菜单 === */

/* 发布 */
.mi-publish { position: relative; width: 36rpx; height: 36rpx; }
.mi-doc {
  position: absolute; top: 0; left: 4rpx;
  width: 24rpx; height: 32rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 4rpx;
}
.mi-pen {
  position: absolute; bottom: 0; right: 0;
  width: 14rpx; height: 14rpx;
  border-right: 3rpx solid var(--primary);
  border-bottom: 3rpx solid var(--primary);
}

/* 参与 - 两个交叠圆 */
.mi-handshake { position: relative; width: 40rpx; height: 36rpx; }
.mi-circle {
  position: absolute; top: 4rpx;
  width: 24rpx; height: 24rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 50%;
}
.mi-circle-l { left: 0; }
.mi-circle-r { right: 0; }

/* 收藏 - 星形 */
.mi-star { position: relative; width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; }
.mi-star-shape {
  width: 28rpx; height: 28rpx;
  background: transparent;
  border: 3rpx solid var(--text-secondary);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

/* 评价 - 对话气泡 */
.mi-chat { position: relative; width: 36rpx; height: 36rpx; }
.mi-chat-bubble {
  position: absolute; top: 0; left: 0;
  width: 32rpx; height: 24rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 10rpx;
}
.mi-chat-bubble::after {
  content: ''; position: absolute; bottom: -8rpx; left: 8rpx;
  width: 0; height: 0;
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-top: 8rpx solid var(--text-secondary);
}

/* 通知 - 铃铛 */
.mi-bell { position: relative; width: 36rpx; height: 36rpx; }
.mi-bell-body {
  position: absolute; top: 4rpx; left: 6rpx;
  width: 20rpx; height: 20rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}
.mi-bell-top {
  position: absolute; top: 0; left: 50%;
  transform: translateX(-50%);
  width: 5rpx; height: 5rpx;
  border-radius: 50%;
  background: var(--text-secondary);
}

/* 历史 - 时钟 */
.mi-clock { position: relative; width: 36rpx; height: 36rpx; }
.mi-clock-circle {
  position: absolute; top: 0; left: 50%;
  transform: translateX(-50%);
  width: 30rpx; height: 30rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 50%;
}
.mi-clock-hand {
  position: absolute; top: 8rpx; left: 50%;
  width: 3rpx; height: 10rpx;
  background: var(--text-secondary);
  transform-origin: bottom center;
  transform: translateX(-50%) rotate(45deg);
}

.menu-label {
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: 400;
}

.menu-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  min-width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  background: var(--danger);
  color: #FFFFFF;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

/* 安全专区 / 更多功能 */
.safe-section {
  padding: 16rpx 32rpx 20rpx;
}

.safe-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.safe-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  transition: all 0.2s;
}

.safe-item:active {
  background: var(--bg-card-hover);
}

.safe-item.danger {
  border: 1rpx solid var(--danger-border);
}

.safe-icon-line {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* === 线条图标：安全专区 === */

/* 搜索 - 放大镜 */
.si-search {
  position: relative;
  width: 36rpx; height: 36rpx;
  display: flex; align-items: center; justify-content: center;
}
.si-search-circle {
  width: 22rpx; height: 22rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 50%;
}
.si-search-handle {
  position: absolute;
  bottom: 6rpx; right: 4rpx;
  width: 10rpx; height: 3rpx;
  background: var(--text-secondary);
  border-radius: 2rpx;
  transform: rotate(45deg);
}

/* 推荐 - 靶心 */
.si-target { position: relative; width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; }
.si-target-outer {
  width: 32rpx; height: 32rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 50%;
}
.si-target-inner {
  position: absolute;
  width: 18rpx; height: 18rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 50%;
}
.si-target-dot {
  position: absolute;
  width: 6rpx; height: 6rpx;
  border-radius: 50%;
  background: var(--primary);
}

/* 投诉 - 邮件 */
.si-mail { position: relative; width: 36rpx; height: 28rpx; }
.si-mail-body {
  position: absolute; top: 0; left: 0;
  width: 36rpx; height: 28rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 4rpx;
}
.si-mail-flap {
  position: absolute; top: 3rpx; left: 3rpx;
  width: 30rpx; height: 14rpx;
  border-bottom: 3rpx solid var(--text-secondary);
  border-left: 3rpx solid var(--text-secondary);
  border-right: 3rpx solid var(--text-secondary);
  border-radius: 0 0 4rpx 4rpx;
  transform: perspective(40rpx) rotateX(50deg);
}

/* 反馈 - 灯泡 */
.si-bulb { position: relative; width: 28rpx; height: 36rpx; }
.si-bulb-body {
  position: absolute; top: 0; left: 50%;
  transform: translateX(-50%);
  width: 24rpx; height: 24rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
}
.si-bulb-base {
  position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%);
  width: 16rpx; height: 6rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 0 0 4rpx 4rpx;
  border-top: none;
}

/* 手机 */
.si-phone { position: relative; width: 22rpx; height: 34rpx; }
.si-phone-body {
  position: absolute; top: 0; left: 0;
  width: 22rpx; height: 34rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 4rpx;
}
.si-phone-body::after {
  content: ''; position: absolute; bottom: 4rpx; left: 50%;
  transform: translateX(-50%);
  width: 8rpx; height: 3rpx;
  border-radius: 2rpx;
  background: var(--text-secondary);
}

/* 分享 */
.si-share { position: relative; width: 36rpx; height: 36rpx; }
.si-share-dot {
  position: absolute;
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  border: 3rpx solid var(--text-secondary);
  background: var(--bg-card);
}
.si-share-dot-1 { top: 0; left: 50%; transform: translateX(-50%); }
.si-share-dot-2 { bottom: 0; left: 4rpx; }
.si-share-dot-3 { bottom: 0; right: 4rpx; }
.si-share-line {
  position: absolute;
  background: var(--text-secondary);
}
.si-share-line-1 { top: 10rpx; left: 12rpx; width: 2rpx; height: 16rpx; transform: rotate(25deg); }
.si-share-line-2 { top: 10rpx; right: 12rpx; width: 2rpx; height: 16rpx; transform: rotate(-25deg); }

/* 关于 (info) */
.si-info { position: relative; width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; }
.si-info-circle {
  width: 32rpx; height: 32rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 50%;
}
.si-info-dot {
  position: absolute;
  top: 7rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx; height: 4rpx;
  border-radius: 50%;
  background: var(--text-secondary);
}
.si-info-line {
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx; height: 12rpx;
  border-radius: 2rpx;
  background: var(--text-secondary);
}

/* 信封 */
.si-mail { position: relative; width: 36rpx; height: 28rpx; display: flex; align-items: center; justify-content: center; }
.si-mail-body {
  width: 32rpx; height: 24rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 4rpx;
}
.si-mail-flap {
  position: absolute;
  top: -2rpx;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 22rpx; height: 22rpx;
  border-top: 3rpx solid var(--text-secondary);
  border-right: 3rpx solid var(--text-secondary);
  border-radius: 2rpx;
}

/* 盾牌 */
.si-shield { position: relative; width: 30rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; }
.si-shield-body {
  width: 28rpx; height: 34rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 4rpx 4rpx 14rpx 14rpx;
}
.si-shield-check {
  position: absolute;
  width: 12rpx; height: 7rpx;
  border-left: 3rpx solid var(--primary);
  border-bottom: 3rpx solid var(--primary);
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

/* SOS */
.si-sos { position: relative; width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; }
.si-sos-circle {
  width: 32rpx; height: 32rpx;
  border: 3rpx solid var(--danger);
  border-radius: 50%;
}
.si-sos-text {
  position: absolute;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--danger);
}

/* 退出 */
.si-logout { position: relative; width: 36rpx; height: 32rpx; }
.si-logout-door {
  position: absolute; top: 0; left: 0;
  width: 22rpx; height: 32rpx;
  border: 3rpx solid var(--danger);
  border-radius: 4rpx;
}
.si-logout-arrow {
  position: absolute; top: 50%; right: 0;
  transform: translateY(-50%);
  width: 16rpx; height: 3rpx;
  background: var(--danger);
}
.si-logout-arrow::after {
  content: ''; position: absolute; right: 0; top: 50%;
  transform: translateY(-50%);
  width: 8rpx; height: 8rpx;
  border-right: 3rpx solid var(--danger);
  border-top: 3rpx solid var(--danger);
  transform: translateY(-50%) rotate(45deg);
}

.safe-label {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: 400;
}

.safe-label.danger-text {
  color: var(--danger);
}

.safe-arrow {
  width: 24rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-chevron {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid var(--text-hint);
  border-bottom: 3rpx solid var(--text-hint);
  transform: rotate(-45deg);
}

/* 底部占位 */
.bottom-placeholder {
  height: 140rpx;
}

/* 登录引导弹窗 */
.login-modal-mask {
  position: fixed;
  inset: 0;
  background: var(--modal-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.login-modal {
  width: 560rpx;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 48rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx var(--overlay-bg);
  border: 1rpx solid var(--border-light);
}

.modal-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

/* 锁线条图标 */
.modal-lock {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}
.ml-body {
  position: absolute; bottom: 0; left: 4rpx;
  width: 28rpx; height: 22rpx;
  border: 3rpx solid var(--primary);
  border-radius: 4rpx;
}
.ml-shackle {
  position: absolute; top: 0; left: 8rpx;
  width: 20rpx; height: 16rpx;
  border: 3rpx solid var(--primary);
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 36rpx;
}

.modal-btns {
  display: flex;
  width: 100%;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.modal-btn:active {
  transform: scale(0.97);
}

.modal-btn-cancel {
  background: var(--card-inner-bg-3);
  color: var(--text-secondary);
  border: 1rpx solid var(--border);
}

.modal-btn-confirm {
  background: var(--primary-gradient);
  color: #FFFFFF;
  box-shadow: var(--btn-shadow-primary);
}

/* ===== 我的信息卡片 ===== */
.info-card-section {
  margin: 24rpx 20rpx;
}

.info-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary, #666);
}

.info-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: var(--card-shadow, 0 2rpx 20rpx rgba(0,0,0,0.06));
}

.info-rows {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 0;
}

.info-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-of-type {
  border-bottom: none;
}

.info-row-empty {
  border-bottom: none;
  justify-content: center;
}

.info-label {
  flex-shrink: 0;
  width: 100rpx;
  font-size: 26rpx;
  color: var(--text-placeholder, #aaa);
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary, #333);
  word-break: break-all;
}

.info-bio {
  color: var(--text-secondary, #666);
  font-style: italic;
}

.info-empty {
  font-size: 26rpx;
  color: var(--text-placeholder, #bbb);
  text-align: center;
  padding: 16rpx 0;
}

.info-edit-btn {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--primary, #00A693);
  padding: 12rpx 0 4rpx;
}

/* ===== 关于我们弹窗 ===== */
.about-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.about-modal {
  width: 620rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 36rpx;
  position: relative;
  z-index: 1;
  overflow-y: auto;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.about-logo-wrap {
  text-align: center;
  margin-bottom: 16rpx;
}

.about-logo-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #FF9500;
  letter-spacing: 4rpx;
}

.about-logo-sub {
  font-size: 20rpx;
  color: #bbb;
  letter-spacing: 6rpx;
  margin-top: 4rpx;
}

.about-version {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.about-body {
  margin-bottom: 28rpx;
}

.about-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.about-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.about-features {
  margin-bottom: 16rpx;
}

.about-feat-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #444;
  line-height: 2;
}

.about-feat-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FF9500;
  flex-shrink: 0;
}

.about-slogan {
  text-align: center;
  font-size: 24rpx;
  color: #FF9500;
  font-weight: 600;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.about-contact {
  background: #fafafa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.about-contact-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.about-contact-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  flex-shrink: 0;
}
.about-contact-join { font-size: 20rpx; color: #FF9500; white-space: nowrap; }

.about-contact-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.about-contact-label {
  font-size: 24rpx;
  color: #999;
}

.about-contact-value {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.about-close-btn {
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #FF9500;
  font-weight: 600;
  border: 2rpx solid #FF9500;
  border-radius: 999rpx;
  margin-top: 8rpx;
}

/* ===== 完善资料弹窗 ===== */
.profile-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.profile-modal {
  width: 580rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.profile-modal-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #FFF3E0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.pm-avatar-circle {
  position: relative;
  width: 52rpx;
  height: 52rpx;
}

.pm-avatar-head {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #FF9500;
  border-radius: 50%;
}

.pm-avatar-body {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 20rpx;
  border: 4rpx solid #FF9500;
  border-bottom: none;
  border-radius: 18rpx 18rpx 0 0;
}

.profile-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.profile-modal-desc {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  line-height: 1.7;
  margin-bottom: 36rpx;
}

.profile-modal-btns {
  display: flex;
  width: 100%;
  gap: 20rpx;
}

.profile-modal-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.pm-btn-skip {
  background: #f5f5f5;
  color: #999;
}

.pm-btn-go {
  background: #FF9500;
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(255, 149, 0, 0.3);
}


