/* pages/credit/index.wxss */
.page-credit {
  min-height: 100vh;
  background: transparent;
  padding-bottom: 40rpx;
  overflow: hidden;
}

.credit-nav {
  border-bottom: none;
  box-shadow: none;
}

/* 顶部卡片 */
.credit-card {
  background: linear-gradient(135deg, #151515, #050505);
  padding: 60rpx 32rpx 40rpx;
  text-align: center;
  margin: 24rpx 32rpx;
  border-radius: 44rpx;
  position: relative;
  overflow: hidden;
}

.gold-dot {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #fff2b8, #facc15 45%, #b7791f 100%);
  opacity: 0.9;
  box-shadow: 0 0 24rpx rgba(250, 204, 21, 0.35);
  pointer-events: none;
}
.dot-lg { width: 72rpx; height: 72rpx; }
.dot-md { width: 44rpx; height: 44rpx; }
.dot-sm { width: 26rpx; height: 26rpx; }
.dot-xs { width: 16rpx; height: 16rpx; }
.dot-1 { top: 34rpx; left: 42rpx; opacity: 0.45; }
.dot-2 { top: 96rpx; right: 58rpx; opacity: 0.7; }
.dot-3 { top: 42rpx; right: 156rpx; opacity: 0.55; }
.dot-4 { bottom: 52rpx; left: 92rpx; opacity: 0.6; }
.dot-5 { bottom: 80rpx; right: 92rpx; opacity: 0.45; }
.dot-6 { bottom: 32rpx; right: 178rpx; opacity: 0.65; }

.credit-circle {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  border: 8rpx solid currentColor;
  color: #fff;
  background: rgba(255,255,255,0.1);
}

.credit-circle.excellent {
  color: #22c55e;
}

.credit-circle.good {
  color: #14b8a6;
}

.credit-circle.average {
  color: #3b82f6;
}

.credit-circle.normal {
  color: #eab308;
}

.credit-circle.bad {
  color: #f97316;
}

.credit-circle.verybad {
  color: #ef4444;
}

.credit-score {
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1;
}

.credit-level {
  font-size: 28rpx;
  margin-top: 8rpx;
  opacity: 0.9;
}

.credit-desc {
  color: rgba(255,255,255,0.7);
  font-size: 24rpx;
}

/* 通用卡片 */
.card {
  margin: 24rpx 32rpx;
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 32rpx;
  border: 1rpx solid var(--border-light);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

/* 等级说明 */
.level-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.level-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.level-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.level-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.level-text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.level-range {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 变动记录 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.record-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.record-left {
  flex: 1;
}

.record-title {
  font-size: 28rpx;
  color: var(--text-primary);
  display: block;
}

.record-time {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
  display: block;
}

.record-right {
  flex-shrink: 0;
}

.record-change {
  font-size: 32rpx;
  font-weight: 700;
}

.record-change.plus {
  color: #22c55e;
}

.record-change.minus {
  color: #ef4444;
}

/* 空状态 */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-hint);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding-top: 24rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

.load-more.empty {
  opacity: 0.6;
}

/* 规则 */
.rule-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rule-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
}

.rule-item.plus {
  background: #f0fdf4;
}

.rule-item.minus {
  background: #fef2f2;
}

.rule-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.rule-item.plus .rule-icon {
  background: #22c55e;
  color: #fff;
}

.rule-item.minus .rule-icon {
  background: #ef4444;
  color: #fff;
}

.rule-content {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rule-title {
  font-size: 28rpx;
  color: var(--text-primary);
}

.rule-desc {
  font-size: 24rpx;
  color: var(--text-hint);
  font-weight: 500;
}

.rule-item.plus .rule-desc {
  color: #166534;
}

.rule-item.minus .rule-desc {
  color: #991b1b;
}

.rule-footer {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rule-footer text {
  font-size: 22rpx;
  color: var(--text-hint);
}

.bottom-space {
  height: 40rpx;
}
