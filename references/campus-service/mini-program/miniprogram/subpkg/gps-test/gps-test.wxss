.page { height: 100vh; background: #f5f5f7; }
.header { padding: 40rpx 30rpx 20rpx; text-align: center; }
.title { font-size: 36rpx; font-weight: 700; color: #1a1a1a; }
.subtitle { font-size: 26rpx; color: #999; margin-top: 10rpx; }

.run-btn {
  margin: 20rpx 30rpx 30rpx;
  background: #007aff;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
}
.run-btn::after { border: none; }
.run-btn[disabled] { background: #a0c4ff; }

.summary {
  margin: 0 30rpx 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #fff;
  color: #333;
  text-align: center;
}

.checks { padding: 0 30rpx 30rpx; }
.check-item {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.check-item.ok { border-left: 6rpx solid #34c759; }
.check-item.fail { border-left: 6rpx solid #ff3b30; }
.check-icon { font-size: 32rpx; margin-right: 16rpx; flex-shrink: 0; margin-top: 2rpx; }
.check-body { flex: 1; min-width: 0; }
.check-label { font-size: 28rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 6rpx; }
.check-detail { font-size: 24rpx; color: #666; word-break: break-all; line-height: 1.5; }
.check-hint { font-size: 24rpx; color: #007aff; margin-top: 8rpx; background: #f0f7ff; padding: 8rpx 12rpx; border-radius: 8rpx; line-height: 1.4; }

.footer-btns { display: flex; gap: 20rpx; padding: 0 30rpx 30rpx; }
.sec-btn {
  flex: 1;
  background: #fff;
  color: #333;
  border-radius: 12rpx;
  font-size: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
  border: 1rpx solid #ddd;
}
.sec-btn::after { border: none; }

.tips { margin: 0 30rpx 40rpx; background: #fff; border-radius: 12rpx; padding: 24rpx; }
.tips-title { font-size: 28rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 16rpx; }
.tip-item { font-size: 24rpx; color: #666; line-height: 1.8; padding: 4rpx 0; }
